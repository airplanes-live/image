# build.sh sets GIT_HASH after sourcing configs, but we need it earlier for
# ARCHIVE_FILENAME below. build-docker.sh exports GIT_HASH into the container,
# so this fallback only fires on bare-host invocations.
: "${GIT_HASH:="$(git -C "${BASE_DIR:-.}" rev-parse HEAD 2>/dev/null || echo unknown)"}"
export GIT_HASH

export IMG_NAME="${IMG_NAME:-airplanes-feeder-dev-arm64}"
# Same-day rebuilds from different commits would collide on pi-gen's default
# `image_${IMG_DATE}-${IMG_NAME}` and silently overwrite the prior artifact.
# Commit short-SHA gives every commit a unique file; same-commit rebuilds
# overwrite themselves (identical content). IMG_DATE is still in the .info.
export ARCHIVE_FILENAME="${ARCHIVE_FILENAME:-${IMG_NAME}-${GIT_HASH:0:7}}"
export CHANNEL="${CHANNEL:-dev}"
export STAGE_LIST="${STAGE_LIST:-${BASE_DIR:-.}/stage0 ${BASE_DIR:-.}/stage1 ${BASE_DIR:-.}/stage2 ${BASE_DIR:-.}/stage-airplanes}"
export DEPLOY_COMPRESSION="${DEPLOY_COMPRESSION:-xz}"
# Pi-gen's default is 6 (slow, ~30% smaller). Level 1 trades ~10-15% size
# growth for roughly 3x faster xz compression — meaningful on a ~700 MB image
# every dev rebuild. Stable channel keeps the upstream default for smaller
# release artifacts.
export COMPRESSION_LEVEL="${COMPRESSION_LEVEL:-1}"
export IMG_SUFFIX="${IMG_SUFFIX:-}"

# Ship sshd up but with password auth off; let cloud-init's ssh_pwauth
# directive (emitted by rpi-imager only when the user explicitly enables
# SSH + password auth in Edit Settings) flip PasswordAuthentication on via
# cc_set_passwords. This makes the v2.0.x customization flow reach working
# SSH (the bare `enable_ssh: true` flag the imager emits is a no-op nobody
# handles, fixed upstream in 2c428de4 but not in any released imager as of
# v2.0.8). Posture per case:
#   - SSH off + user/pass set     → user created, sshd up but pwauth off,
#                                   no key dropped → no SSH access (matches
#                                   "password is for console only" intent)
#   - SSH on + key                → ssh_pwauth: false → key auth only
#   - SSH on + password           → ssh_pwauth: true  → password SSH works
#   - No customization at all     → only the upstream pi user with
#                                   --disabled-login, no creds → sshd
#                                   reachable but unauthenticatable
export ENABLE_SSH="${ENABLE_SSH:-1}"
export PUBKEY_ONLY_SSH="${PUBKEY_ONLY_SSH:-1}"

# Branch-tracking on dev — moving target by design, catches upstream drift early.
export AIRPLANES_FEED_REPO="${AIRPLANES_FEED_REPO:-https://github.com/airplanes-live/feed.git}"
export AIRPLANES_FEED_BRANCH="${AIRPLANES_FEED_BRANCH:-dev}"

