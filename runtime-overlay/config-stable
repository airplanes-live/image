# Runtime-overlay channel pins (stable).
#
# Sourced by the runtime-overlay build helpers
# (runtime-overlay/scripts/lib/component-pins.sh,
# runtime-overlay/scripts/lib/cross-compile-readsb.sh,
# runtime-overlay/scripts/lib/cross-compile-dump978.sh,
# runtime-overlay/scripts/lib/stage-tar1090.sh,
# runtime-overlay/scripts/lib/stage-graphs1090.sh) to pin the upstream
# sources baked into runtime-overlay assets published inside stable product
# releases.
#
# Scope covers the full overlay payload: the inbound-decode stack — readsb
# (wiedehopf), dump978-fa (flightaware), tar1090 (wiedehopf), tar1090-db
# (wiedehopf), graphs1090 (wiedehopf) — plus the feed scripts, the outbound
# airplanes-live/readsb fork (airplanes-feed binary), mlat-client, and
# image-webconfig, all pinned below and installed via the overlay. The
# image-level config-stable pins only the feed test-harness checkout ref.
#
# Stable pins are 40-hex commit SHAs so stable runtime-overlay assets are
# reproducible from this file. Bump in lockstep with PRs that have already
# been validated on the dev channel.

export AIRPLANES_READSB_DECODER_REPO="${AIRPLANES_READSB_DECODER_REPO:-https://github.com/wiedehopf/readsb.git}"
export AIRPLANES_READSB_DECODER_BRANCH="${AIRPLANES_READSB_DECODER_BRANCH:-0bfd0473d0d6c9bd46dcc7091a323b945b165d15}"

export AIRPLANES_DUMP978_REPO="${AIRPLANES_DUMP978_REPO:-https://github.com/flightaware/dump978.git}"
export AIRPLANES_DUMP978_BRANCH="${AIRPLANES_DUMP978_BRANCH:-41516d887096a511546fd50653459d3bd8e05d16}"

export AIRPLANES_TAR1090_REPO="${AIRPLANES_TAR1090_REPO:-https://github.com/wiedehopf/tar1090.git}"
export AIRPLANES_TAR1090_BRANCH="${AIRPLANES_TAR1090_BRANCH:-d892b99d75ed0d09927a2af9b97587c37c8b2d58}"

export AIRPLANES_TAR1090_DB_REPO="${AIRPLANES_TAR1090_DB_REPO:-https://github.com/wiedehopf/tar1090-db.git}"
export AIRPLANES_TAR1090_DB_BRANCH="${AIRPLANES_TAR1090_DB_BRANCH:-608668c169dea8bfad1968adfd19770eced88cd8}"

export AIRPLANES_GRAPHS1090_REPO="${AIRPLANES_GRAPHS1090_REPO:-https://github.com/wiedehopf/graphs1090.git}"
export AIRPLANES_GRAPHS1090_BRANCH="${AIRPLANES_GRAPHS1090_BRANCH:-426c70c61889de2a8f63f2b40133ea72a08537ce}"

# Webconfig — downloaded as a prebuilt release, not compiled in the overlay.
# Pinned to a concrete stable release. v0.4.0 is the first release carrying the
# /opt/airplanes FHS on-device layout, matching the overlay this channel builds.
# COMMIT_SHA must equal the release manifest's commit_sha — stage-webconfig.sh
# hard-fails the build on mismatch.
export AIRPLANES_WEBCONFIG_RELEASE_TAG="${AIRPLANES_WEBCONFIG_RELEASE_TAG:-v0.4.0}"
export AIRPLANES_WEBCONFIG_COMMIT_SHA="${AIRPLANES_WEBCONFIG_COMMIT_SHA:-7ed56223b1e8d844d5dde1c31690f6c03a9e139f}"

# Feed scripts — overlay-built. The feed repo's only tag (v0.0.1) lags the dev
# head, so the stable pin is the current feed dev HEAD SHA as of this pin date
# (the pin must be a 40-hex SHA per test_channel_configs.bats).
export AIRPLANES_FEED_OVERLAY_REPO="${AIRPLANES_FEED_OVERLAY_REPO:-https://github.com/airplanes-live/feed.git}"
export AIRPLANES_FEED_OVERLAY_BRANCH="${AIRPLANES_FEED_OVERLAY_BRANCH:-18a07314a49f483e545d00da2532c72ccda03e5f}"

# Feeder readsb fork (outbound airplanes-feed binary). The repo's version tags
# mirror upstream wiedehopf and lag the fork's dev head by hundreds of commits,
# so the stable pin is the current dev HEAD SHA as of this pin date.
export AIRPLANES_FEED_READSB_REPO="${AIRPLANES_FEED_READSB_REPO:-https://github.com/airplanes-live/readsb.git}"
export AIRPLANES_FEED_READSB_BRANCH="${AIRPLANES_FEED_READSB_BRANCH:-0adaebb8d49988fb8e2db5dc835daf7e95aea496}"

# mlat-client. Latest tag (v0.4.2) lags the master head by ~30 commits, so the
# stable pin is the current master HEAD SHA as of this pin date.
export AIRPLANES_MLAT_CLIENT_REPO="${AIRPLANES_MLAT_CLIENT_REPO:-https://github.com/airplanes-live/mlat-client.git}"
export AIRPLANES_MLAT_CLIENT_BRANCH="${AIRPLANES_MLAT_CLIENT_BRANCH:-f569b6d230d5095e80c7b67bb37b1e72f2bd8da8}"
