#!/bin/bash
# airplanes-update-orchestrator — drive the four feeder-update phases as a
# single sequenced run so the webconfig "Update System" button has one
# entry point instead of four.
#
# Phases, in order:
#   1. apt        — apt-get update && upgrade. Not rollbackable; the state
#                   file records that fact so the UI can surface it.
#   2. feed       — invoke the on-device feed scripts' update entrypoint
#                   (/usr/local/share/airplanes/update.sh). After this step
#                   succeeds, SIGHUP airplanes-webconfig so any feed-env
#                   schema changes are picked up.
#   3. webconfig  — invoke the webconfig self-update helper. The helper is
#                   the source of truth for "is anything newer" — it does
#                   its own preflight against the release channel and
#                   no-ops cleanly when nothing is pending. A coarse
#                   "helper exists and is executable" gate skips the step
#                   entirely on feeders that have not yet had it laid down.
#   4. runtime    — same shape as webconfig: invoke unconditionally when
#                   the helper is present; skip otherwise.
#
# Each step writes /run/airplanes/orchestrator.state atomically before and
# after running so an HTTP poller (GET /api/orchestrator/state) can render
# progress. On step failure, the state file records the failed step and
# the process exits non-zero — subsequent steps are not invoked.
#
# Pin the physical lib dir at startup so a `current` symlink flip mid-run
# (the runtime step deliberately flips it) does not desync subsequent
# logic — though this script does not source anything else from its own
# directory, the pinning keeps logging output truthful.
#
# Sudoers / privilege boundary
# ----------------------------
# In production the orchestrator is invoked via a sudoers-pinned
# `systemd-run --unit=airplanes-update-orchestrator.service ... start-orchestrator.sh`
# (C-2 work, separate repo). sudoers' env_reset gives a clean environment
# so the AIRPLANES_ORCHESTRATOR_* overrides below are not exploitable by
# the unprivileged webconfig service account that triggers the start.
# The overrides exist for bats-driven test isolation only; the defaults
# are absolute paths so a production invocation never reads them.

set -Eeuo pipefail

_self_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck disable=SC2034  # logged at startup for triage
readonly _self_dir

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

: "${AIRPLANES_ORCHESTRATOR_STATE_FILE:=/run/airplanes/orchestrator.state}"
: "${AIRPLANES_ORCHESTRATOR_LOCK_FILE:=/run/airplanes/orchestrator.lock}"
: "${AIRPLANES_ORCHESTRATOR_FEED_UPDATE:=/usr/local/share/airplanes/update.sh}"
: "${AIRPLANES_ORCHESTRATOR_WEBCONFIG_UPDATE:=/usr/local/lib/airplanes-webconfig/webconfig-self-update.sh}"
: "${AIRPLANES_ORCHESTRATOR_RUNTIME_UPDATE:=/opt/airplanes-runtime/current/lib/runtime-self-update.sh}"
: "${AIRPLANES_ORCHESTRATOR_RUNTIME_UPGRADE_STATE:=/var/lib/airplanes-runtime-upgrade/upgrade-state}"
: "${AIRPLANES_ORCHESTRATOR_WEBCONFIG_SERVICE:=airplanes-webconfig.service}"
: "${AIRPLANES_ORCHESTRATOR_SYSTEMCTL:=/usr/bin/systemctl}"
: "${AIRPLANES_ORCHESTRATOR_APT_GET:=/usr/bin/apt-get}"

readonly STATE_FILE="$AIRPLANES_ORCHESTRATOR_STATE_FILE"
readonly LOCK_FILE="$AIRPLANES_ORCHESTRATOR_LOCK_FILE"

# ---------------------------------------------------------------------------
# Flock — acquired before any state-file write or sub-helper invocation so
# two concurrent root invocations (e.g. a botched systemd-run that bypasses
# the unit-name dedup, or a manual root retry alongside an in-flight run)
# serialise rather than racing on apt and the per-component self-updaters.
# A losing invocation exits 75 (EX_TEMPFAIL) without touching the state
# file — the webconfig capability gate translates that to HTTP 503.
# ---------------------------------------------------------------------------

install -d -m 0755 "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "orchestrator: another update is in progress (lock held: $LOCK_FILE)" >&2
    exit 75
fi

# ---------------------------------------------------------------------------
# State file — JSON with atomic write via tmp + mv -f.
# ---------------------------------------------------------------------------

# escape_json <string> — minimal escaping for JSON string scalars. Covers
# backslashes, double quotes, and the control characters we expect to see
# in error messages. Sufficient for the small surface we serialise here.
escape_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

iso8601_now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Track the apt step's "we ran something" flag once it crosses into the
# unrollbackable region. The state file mirrors this so the UI can render
# "apt changes are irreversible" even after a subsequent step fails.
APT_IRREVERSIBLE=0

# Persisted state across step transitions. write_state replaces the file
# atomically so a reader never observes a half-written line.
#
# Args:
#   $1  step    — apt | feed | webconfig | runtime | idle | done | failed
#   $2  status  — pending | running | ok | skipped | failed | rollback
#   $3  error   — error message (optional; "" if absent)
#   $4  finished_at — RFC3339 timestamp (optional; "" → null in JSON)
write_state() {
    local step="$1" status="$2" err="${3-}" finished_at="${4-}"
    install -d -m 0755 "$(dirname "$STATE_FILE")"

    local started_at_field=""
    if [[ -n "${STARTED_AT:-}" ]]; then
        started_at_field="\"$STARTED_AT\""
    else
        started_at_field='null'
    fi

    local finished_at_field='null'
    if [[ -n "$finished_at" ]]; then
        finished_at_field="\"$finished_at\""
    fi

    local error_field='null'
    if [[ -n "$err" ]]; then
        error_field="\"$(escape_json "$err")\""
    fi

    local apt_irreversible_field='false'
    if [[ "$APT_IRREVERSIBLE" -eq 1 ]]; then
        apt_irreversible_field='true'
    fi

    local tmp
    tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
    cat > "$tmp" <<JSON
{
  "step": "$(escape_json "$step")",
  "status": "$(escape_json "$status")",
  "started_at": $started_at_field,
  "finished_at": $finished_at_field,
  "error": $error_field,
  "apt_irreversible": $apt_irreversible_field
}
JSON
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$STATE_FILE"
}

# ---------------------------------------------------------------------------
# Step helpers
# ---------------------------------------------------------------------------

# run_step <step-name> <command...> — wraps a step invocation with the
# before/after state-file writes. Sets STARTED_AT for the duration of the
# call so write_state emits a coherent started_at field.
#
# Returns the step command's exit code. The caller decides whether to bail
# (every step except the apt "irreversibility" toggle treats non-zero as
# fatal-stop).
run_step() {
    local step="$1"
    shift

    STARTED_AT="$(iso8601_now)"
    write_state "$step" running ""

    local rc=0
    "$@" || rc=$?

    local finished_at
    finished_at="$(iso8601_now)"
    if [[ "$rc" -eq 0 ]]; then
        write_state "$step" ok "" "$finished_at"
    else
        write_state "$step" failed "step exited with code $rc" "$finished_at"
    fi

    STARTED_AT=""
    return "$rc"
}

# helper_present <path> — coarse "skip this step entirely" gate for the
# webconfig and runtime-overlay self-update helpers. Both helpers run
# their own preflight against the release channel and no-op cleanly when
# nothing is newer, so we do not attempt a separate dry-run here — the
# helper is the source of truth. The gate exists so feeders that have
# not yet had the helper laid down (build-time race; bootstrap before
# C-2 is consumed) skip without surfacing a hard failure.
helper_present() {
    [[ -x "$1" ]]
}

# ---------------------------------------------------------------------------
# Step implementations
# ---------------------------------------------------------------------------
# The step_* functions are invoked indirectly via run_step "$@" further
# down; shellcheck cannot statically prove the call edges, so each one
# carries its own SC2317 suppression.

# shellcheck disable=SC2317  # invoked indirectly via run_step
step_apt() {
    local apt_get="$AIRPLANES_ORCHESTRATOR_APT_GET"
    if ! command -v "$apt_get" >/dev/null 2>&1; then
        # No apt-get on PATH — environment is degraded, but the apt step
        # cannot do work and has not made any system mutations. Surface
        # as a skip rather than a hard failure so the rest of the
        # orchestrator can still run. APT_IRREVERSIBLE was raised by the
        # caller before this step ran; reset it since no mutation
        # happened.
        echo "orchestrator: apt-get not found in PATH; skipping apt step" >&2
        APT_IRREVERSIBLE=0
        return 0
    fi
    # Chain with && so any non-zero rc surfaces. APT_IRREVERSIBLE is
    # already set by the caller before this step started — that
    # ensures any state-file write during the mutation window mirrors
    # the right value even on a hang or crash.
    DEBIAN_FRONTEND=noninteractive "$apt_get" update \
        && DEBIAN_FRONTEND=noninteractive "$apt_get" -y upgrade
}

# shellcheck disable=SC2317  # invoked indirectly via run_step
step_feed() {
    if [[ ! -x "$AIRPLANES_ORCHESTRATOR_FEED_UPDATE" ]]; then
        echo "orchestrator: feed updater not found at $AIRPLANES_ORCHESTRATOR_FEED_UPDATE" >&2
        return 1
    fi
    "$AIRPLANES_ORCHESTRATOR_FEED_UPDATE"
}

# step_feed_hup — issue SIGHUP to airplanes-webconfig so a feed-env-schema
# change picked up by the feed step is observed by the live webconfig
# process. Failure to HUP is logged but not fatal (the webconfig will
# pick up the new schema on its next restart regardless).
step_feed_hup() {
    local systemctl="$AIRPLANES_ORCHESTRATOR_SYSTEMCTL"
    if ! command -v "$systemctl" >/dev/null 2>&1; then
        echo "orchestrator: systemctl not found; skipping HUP after feed" >&2
        return 0
    fi
    "$systemctl" kill -s HUP "$AIRPLANES_ORCHESTRATOR_WEBCONFIG_SERVICE" || \
        echo "orchestrator: SIGHUP to $AIRPLANES_ORCHESTRATOR_WEBCONFIG_SERVICE failed; continuing" >&2
}

# shellcheck disable=SC2317  # invoked indirectly
step_webconfig() {
    if [[ ! -x "$AIRPLANES_ORCHESTRATOR_WEBCONFIG_UPDATE" ]]; then
        echo "orchestrator: webconfig updater not found at $AIRPLANES_ORCHESTRATOR_WEBCONFIG_UPDATE" >&2
        return 1
    fi
    "$AIRPLANES_ORCHESTRATOR_WEBCONFIG_UPDATE"
}

# shellcheck disable=SC2317  # invoked indirectly
step_runtime() {
    if [[ ! -x "$AIRPLANES_ORCHESTRATOR_RUNTIME_UPDATE" ]]; then
        echo "orchestrator: runtime updater not found at $AIRPLANES_ORCHESTRATOR_RUNTIME_UPDATE" >&2
        return 1
    fi
    local rc=0
    "$AIRPLANES_ORCHESTRATOR_RUNTIME_UPDATE" || rc=$?
    if [[ "$rc" -eq 0 ]]; then
        return 0
    fi
    # The runtime self-updater treats a same-version replay (no newer
    # release on the channel) as FAILED_PRE_MUTATION with a
    # failure_reason of `same_version_replay_<version>`. From the
    # orchestrator's "is anything newer" perspective that is a no-op,
    # not a failure — translate it. Any other failure (download, verify,
    # health gate) surfaces as a real step failure.
    local state_file="$AIRPLANES_ORCHESTRATOR_RUNTIME_UPGRADE_STATE"
    if [[ -r "$state_file" ]]; then
        local upg_state upg_reason
        upg_state="$(awk -F= '/^state=/ { sub(/^state=/, ""); print; exit }' "$state_file" 2>/dev/null || true)"
        upg_reason="$(awk -F= '/^failure_reason=/ { sub(/^failure_reason=/, ""); print; exit }' "$state_file" 2>/dev/null || true)"
        if [[ "$upg_state" == "FAILED_PRE_MUTATION" && "$upg_reason" == same_version_replay_* ]]; then
            echo "orchestrator: runtime self-updater reports no newer release ($upg_reason); treating as no-op" >&2
            return 0
        fi
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# Error trap — record FAILED into the state file so a poller observes the
# terminal state even if we exit via set -e.
# ---------------------------------------------------------------------------

CURRENT_STEP="idle"

# shellcheck disable=SC2317  # invoked indirectly via trap ERR
on_err() {
    local rc=$?
    local at
    at="$(iso8601_now)"
    write_state "$CURRENT_STEP" failed "orchestrator aborted at step '$CURRENT_STEP' with code $rc" "$at"
    exit "$rc"
}
trap on_err ERR

# ---------------------------------------------------------------------------
# Sequence
# ---------------------------------------------------------------------------

# Initial idle state on entry — clobbers any previous run's terminal state
# so the UI doesn't render a stale "failed" while the orchestrator is in
# fact running again.
write_state idle running ""

# apt — fatal on failure (irreversible). Raise APT_IRREVERSIBLE BEFORE
# the `running` state-file write so a poller that lands during the apt
# mutation window observes the correct flag.
CURRENT_STEP="apt"
APT_IRREVERSIBLE=1
if ! run_step apt step_apt; then
    exit 1
fi

# feed — fatal on failure. On success, HUP webconfig so feed-env schema
# changes are observed in the running process.
CURRENT_STEP="feed"
if ! run_step feed step_feed; then
    exit 1
fi
step_feed_hup

# webconfig — skip when the helper has not been laid down yet; otherwise
# invoke unconditionally and let the helper's own preflight decide
# whether anything is actually newer.
CURRENT_STEP="webconfig"
STARTED_AT="$(iso8601_now)"
if helper_present "$AIRPLANES_ORCHESTRATOR_WEBCONFIG_UPDATE"; then
    write_state webconfig running ""
    if ! step_webconfig; then
        write_state webconfig failed "webconfig self-update exited non-zero" "$(iso8601_now)"
        exit 1
    fi
    write_state webconfig ok "" "$(iso8601_now)"
else
    write_state webconfig skipped "" "$(iso8601_now)"
fi
STARTED_AT=""

# runtime-overlay — same gating shape as webconfig.
CURRENT_STEP="runtime"
STARTED_AT="$(iso8601_now)"
if helper_present "$AIRPLANES_ORCHESTRATOR_RUNTIME_UPDATE"; then
    write_state runtime running ""
    if ! step_runtime; then
        write_state runtime failed "runtime self-update exited non-zero" "$(iso8601_now)"
        exit 1
    fi
    write_state runtime ok "" "$(iso8601_now)"
else
    write_state runtime skipped "" "$(iso8601_now)"
fi
STARTED_AT=""

# Terminal — done.
trap - ERR
write_state "done" ok "" "$(iso8601_now)"
exit 0
