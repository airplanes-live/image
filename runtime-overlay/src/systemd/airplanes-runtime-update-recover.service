[Unit]
Description=Resume an interrupted airplanes runtime overlay update
DefaultDependencies=no
After=local-fs.target
# Ordered before every runtime-overlay-consumer unit so a half-flipped
# `current` symlink cannot be reached by a daemon depending on the
# overlay's binaries / configs. Decoder + UAT services consume
# /opt/airplanes-runtime/current/bin and /share/airplanes; tar1090 /
# graphs1090 / lighttpd / collectd consume /share or /etc snippets
# under current.
Before=readsb.service dump978-fa.service airplanes-978.service
Before=airplanes-tar1090-uat-sync.service airplanes-tar1090-uat-sync.path
Before=tar1090.service graphs1090.service
Before=collectd.service lighttpd.service
RequiresMountsFor=/opt /var/lib/airplanes-runtime-upgrade
ConditionPathExists=/opt/airplanes-runtime/current/lib/airplanes-runtime-update-recover.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/airplanes-runtime/current/lib/airplanes-runtime-update-recover.sh

[Install]
WantedBy=multi-user.target
