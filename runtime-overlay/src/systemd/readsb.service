[Unit]
Description=readsb local 1090 MHz decoder
After=airplanes-first-run.service network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/airplanes/feed.env
User=readsb
RuntimeDirectory=readsb
RuntimeDirectoryMode=0755
# Keep /run/readsb across the pinned-SDR-absent self-disable cycle (sleep +
# exit 0 → Restart=always) so readsb.sh's /run/readsb/state survives for
# render-status/webconfig to read between polls. `restart` (not `yes`) scopes
# preservation to auto-restarts: a clean `systemctl stop` still clears the
# dir, so a stale aircraft.json/stats.prom doesn't linger until reboot. Mode
# 0755 keeps the state file readable by the webconfig service user.
RuntimeDirectoryPreserve=restart
ExecStart=/usr/local/share/airplanes/readsb.sh
Restart=always
RestartSec=15
Nice=-5

[Install]
WantedBy=multi-user.target
