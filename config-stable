# build.sh sets GIT_HASH after sourcing configs, but we need it earlier for
# ARCHIVE_FILENAME below. build-docker.sh exports GIT_HASH into the container,
# so this fallback only fires on bare-host invocations.
: "${GIT_HASH:="$(git -C "${BASE_DIR:-.}" rev-parse HEAD 2>/dev/null || echo unknown)"}"
export GIT_HASH

export IMG_NAME="${IMG_NAME:-airplanes-feeder-stable-arm64}"
# Same-day rebuilds from different commits would collide on pi-gen's default
# `image_${IMG_DATE}-${IMG_NAME}` and silently overwrite the prior artifact.
# Commit short-SHA gives every commit a unique file; same-commit rebuilds
# overwrite themselves (identical content). IMG_DATE is still in the .info.
export ARCHIVE_FILENAME="${ARCHIVE_FILENAME:-${IMG_NAME}-${GIT_HASH:0:7}}"
export CHANNEL="${CHANNEL:-stable}"
export STAGE_LIST="${STAGE_LIST:-${BASE_DIR:-.}/stage0 ${BASE_DIR:-.}/stage1 ${BASE_DIR:-.}/stage2 ${BASE_DIR:-.}/stage-airplanes}"
export DEPLOY_COMPRESSION="${DEPLOY_COMPRESSION:-xz}"
export IMG_SUFFIX="${IMG_SUFFIX:-}"

# Ship sshd enabled with password authentication — the stock OpenSSH default;
# we no longer drop a hardening snippet to disable it. The image bakes a
# default pi/airplanes login (FIRST_USER_PASS below) so a fresh feeder is
# reachable over SSH out of the box; users are expected to change it. The bare
# `enable_ssh: true` flag rpi-imager v2.0.x emits is a no-op nobody handles
# (fixed upstream in 2c428de4 but unreleased as of v2.0.8), so we ship sshd
# already enabled. rpi-imager customization overrides the default login: its
# own user/pass or an injected SSH key arrives via cloud-init at first boot.
export ENABLE_SSH="${ENABLE_SSH:-1}"

# Default first-user credentials baked into the image (FIRST_USER_NAME defaults
# to "pi" in build.sh). DISABLE_FIRST_BOOT_USER_RENAME=1 ships that user as-is;
# build.sh requires FIRST_USER_PASS in that mode, and the first-boot rename
# stage is already skipped (export-image/01-user-rename/SKIP).
export FIRST_USER_PASS="${FIRST_USER_PASS:-airplanes}"
export DISABLE_FIRST_BOOT_USER_RENAME="${DISABLE_FIRST_BOOT_USER_RENAME:-1}"

# Feed test-harness checkout ref. NOT the feed baked into the image (that ships
# via the runtime overlay, pinned in runtime-overlay/config-stable) — this ref
# is checked out by build-image.yml's boot-smoke and overlay-smoke jobs to run
# feed's own test/image-boot.sh against the built image. Must match the commit
# the overlay pins.
export AIRPLANES_FEED_REPO="${AIRPLANES_FEED_REPO:-https://github.com/airplanes-live/feed.git}"
# feed v0.0.1
export AIRPLANES_FEED_BRANCH="${AIRPLANES_FEED_BRANCH:-d120b953329ab8c1d9d613d9cdcd57c471ca1914}"
# Runtime update channel baked into /etc/airplanes/release-channel by stage
# 06. The feed-side resolver reads this at update time and (for stable)
# resolves the latest v[MAJOR].[MINOR].[PATCH] release tag via git
# ls-remote. AIRPLANES_FEED_BRANCH above pins the BUILD-time source clone;
# AIRPLANES_FEED_UPDATE_CHANNEL below names the RUNTIME release stream.
# Allowlist enforced by stage 06: stable, dev.
export AIRPLANES_FEED_UPDATE_CHANNEL="${AIRPLANES_FEED_UPDATE_CHANNEL:-stable}"

# webconfig ships inside the runtime overlay (built/pinned in
# runtime-overlay/config-stable, not cloned by a stage here). The authoritative
# pin is runtime-overlay/config-stable's AIRPLANES_WEBCONFIG_COMMIT_SHA, which
# ci.yml now sources directly for its shell-tests / systemd-verify checkout. The
# pin below is retained only for the overlay-smoke / update-regression test
# harness (which passes it through to docker) and MUST equal the overlay
# COMMIT_SHA (image-webconfig v0.1.3 commit). Must be a post-self-update-removal
# ref — the v0.1.x tags up to v0.1.2 still carried the removed self-update
# surface.
export AIRPLANES_WEBCONFIG_REPO="${AIRPLANES_WEBCONFIG_REPO:-https://github.com/airplanes-live/image-webconfig.git}"
export AIRPLANES_WEBCONFIG_BRANCH="${AIRPLANES_WEBCONFIG_BRANCH:-2063d1b2a5c44e40251f51080d45519f1433eb97}"

# Legacy/unused: the outbound feeder readsb now ships via the runtime overlay
# (pinned in runtime-overlay/config-stable as AIRPLANES_FEED_READSB_BRANCH).
# This pin is still loaded into GITHUB_ENV by build-image.yml but no longer
# consumed by any build stage; left in place to defer the workflow cleanup.
export AIRPLANES_READSB_REPO="${AIRPLANES_READSB_REPO:-https://github.com/airplanes-live/readsb.git}"
export AIRPLANES_READSB_BRANCH="${AIRPLANES_READSB_BRANCH:-4d6c614d7940ce0117db61b1fa91c81fd9e67988}"
