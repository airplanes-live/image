# build.sh sets GIT_HASH after sourcing configs, but we need it earlier for
# ARCHIVE_FILENAME below. build-docker.sh exports GIT_HASH into the container,
# so this fallback only fires on bare-host invocations.
: "${GIT_HASH:="$(git -C "${BASE_DIR:-.}" rev-parse HEAD 2>/dev/null || echo unknown)"}"
export GIT_HASH

export IMG_NAME="${IMG_NAME:-airplanes-feeder-stable-arm64}"
# Same-day rebuilds from different commits would collide on pi-gen's default
# `image_${IMG_DATE}-${IMG_NAME}` and silently overwrite the prior artifact.
# Commit short-SHA gives every commit a unique file; same-commit rebuilds
# overwrite themselves (identical content). IMG_DATE is still in the .info.
export ARCHIVE_FILENAME="${ARCHIVE_FILENAME:-${IMG_NAME}-${GIT_HASH:0:7}}"
export CHANNEL="${CHANNEL:-stable}"
export STAGE_LIST="${STAGE_LIST:-${BASE_DIR:-.}/stage0 ${BASE_DIR:-.}/stage1 ${BASE_DIR:-.}/stage2 ${BASE_DIR:-.}/stage-airplanes}"
export DEPLOY_COMPRESSION="${DEPLOY_COMPRESSION:-xz}"
export IMG_SUFFIX="${IMG_SUFFIX:-}"

# Ship sshd enabled so rpi-imager's v2.0.x customization can reach a working
# SSH posture (the bare `enable_ssh: true` flag the imager emits is a no-op
# nobody handles — fixed upstream in 2c428de4 but not yet released as of
# v2.0.8). Password auth stays off in shipped sshd_config via
# stage-airplanes/00-prep/02-run.sh dropping
# /etc/ssh/sshd_config.d/90-airplanes.conf; cloud-init's 50-cloud-init.conf
# wins lexical order when ssh_pwauth is emitted. Posture per case:
#   - SSH off + user/pass set     → user created, sshd up but pwauth off,
#                                   no key dropped → no SSH access (matches
#                                   "password is for console only" intent)
#   - SSH on + key                → ssh_pwauth: false → key auth only
#   - SSH on + password           → ssh_pwauth: true  → password SSH works
#   - No customization at all     → only the upstream pi user with
#                                   --disabled-login, no creds → sshd
#                                   reachable but unauthenticatable
export ENABLE_SSH="${ENABLE_SSH:-1}"

# Pinned SHAs. Bump in lockstep with PRs that have been validated on dev.
# Resolution helpers (run before bumping):
#   gh api repos/airplanes-live/feed/commits/main --jq .sha
#   gh api repos/airplanes-live/readsb/commits/dev --jq .sha

export AIRPLANES_FEED_REPO="${AIRPLANES_FEED_REPO:-https://github.com/airplanes-live/feed.git}"
export AIRPLANES_FEED_BRANCH="${AIRPLANES_FEED_BRANCH:-9318d02efd70488f831cbcb84ca3ec4cb9cc9ece}"
# Runtime update channel baked into /etc/airplanes/release-channel by stage
# 06. The feed-side resolver reads this at update time and (for stable)
# resolves the latest v[MAJOR].[MINOR].[PATCH] release tag via git
# ls-remote. AIRPLANES_FEED_BRANCH above pins the BUILD-time source clone;
# AIRPLANES_FEED_UPDATE_CHANNEL below names the RUNTIME release stream.
# Allowlist enforced by stage 06: stable, dev.
export AIRPLANES_FEED_UPDATE_CHANNEL="${AIRPLANES_FEED_UPDATE_CHANNEL:-stable}"

# webconfig moved out of this repo; stage 05 clones airplanes-live/image-webconfig
# at AIRPLANES_WEBCONFIG_BRANCH and consumes the matching GitHub Release. For
# config-stable this is a concrete release tag — bump it via the same procedure
# as the other component pins above.
export AIRPLANES_WEBCONFIG_REPO="${AIRPLANES_WEBCONFIG_REPO:-https://github.com/airplanes-live/image-webconfig.git}"
export AIRPLANES_WEBCONFIG_BRANCH="${AIRPLANES_WEBCONFIG_BRANCH:-v0.1.1}"

export AIRPLANES_READSB_REPO="${AIRPLANES_READSB_REPO:-https://github.com/airplanes-live/readsb.git}"
export AIRPLANES_READSB_BRANCH="${AIRPLANES_READSB_BRANCH:-4d6c614d7940ce0117db61b1fa91c81fd9e67988}"

# Runtime overlay release tag pinned for the stable image build. Set to a
# placeholder until the first runtime-vX.Y.Z release is cut; the stable
# channel image build will fail until a concrete runtime tag exists. Bump
# to a concrete runtime-vX.Y.Z once a stable runtime release has been
# published.
export AIRPLANES_RUNTIME_OVERLAY_TAG="${AIRPLANES_RUNTIME_OVERLAY_TAG:-runtime-v0.0.0-unreleased}"
