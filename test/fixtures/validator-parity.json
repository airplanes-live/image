{
  "_doc": "Shared fixtures for the JS vs bash validator parity test. Each row asserts both sides agree. Sourced by test/test_validator_parity.sh.",
  "tests": [
    { "validator": "latitude", "value": "0",          "expected": true  },
    { "validator": "latitude", "value": "52.5",       "expected": true  },
    { "validator": "latitude", "value": "-52.5",      "expected": true  },
    { "validator": "latitude", "value": "+52.5",      "expected": true  },
    { "validator": "latitude", "value": "90",         "expected": true  },
    { "validator": "latitude", "value": "-90",        "expected": true  },
    { "validator": "latitude", "value": "90.0",       "expected": true  },
    { "validator": "latitude", "value": "90.0001",    "expected": false },
    { "validator": "latitude", "value": "-90.0001",   "expected": false },
    { "validator": "latitude", "value": "abc",        "expected": false },
    { "validator": "latitude", "value": "52abc",      "expected": false },
    { "validator": "latitude", "value": "",           "expected": false },
    { "validator": "latitude", "value": ".5",         "expected": false },
    { "validator": "latitude", "value": "5.",         "expected": false },
    { "validator": "latitude", "value": "1e1",        "expected": false },
    { "validator": "latitude", "value": "Infinity",   "expected": false },
    { "validator": "latitude", "value": "NaN",        "expected": false },

    { "validator": "longitude", "value": "0",         "expected": true  },
    { "validator": "longitude", "value": "13.4",      "expected": true  },
    { "validator": "longitude", "value": "-13.4",     "expected": true  },
    { "validator": "longitude", "value": "+180",      "expected": true  },
    { "validator": "longitude", "value": "180",       "expected": true  },
    { "validator": "longitude", "value": "-180",      "expected": true  },
    { "validator": "longitude", "value": "180.0001",  "expected": false },
    { "validator": "longitude", "value": "-180.0001", "expected": false },
    { "validator": "longitude", "value": "abc",       "expected": false },
    { "validator": "longitude", "value": "",          "expected": false },
    { "validator": "longitude", "value": ".5",        "expected": false },
    { "validator": "longitude", "value": "5.",        "expected": false },
    { "validator": "longitude", "value": "1e2",       "expected": false },

    { "validator": "altitude",  "value": "0",         "expected": true  },
    { "validator": "altitude",  "value": "120m",      "expected": true  },
    { "validator": "altitude",  "value": "120ft",     "expected": true  },
    { "validator": "altitude",  "value": "120.5m",    "expected": true  },
    { "validator": "altitude",  "value": "120.5",     "expected": true  },
    { "validator": "altitude",  "value": "-1000m",    "expected": true  },
    { "validator": "altitude",  "value": "10000m",    "expected": true  },
    { "validator": "altitude",  "value": "10001m",    "expected": false },
    { "validator": "altitude",  "value": "-1001m",    "expected": false },
    { "validator": "altitude",  "value": "120k",      "expected": false },
    { "validator": "altitude",  "value": "abc",       "expected": false },
    { "validator": "altitude",  "value": "",          "expected": false },
    { "validator": "altitude",  "value": ".5m",       "expected": false },
    { "validator": "altitude",  "value": "+120m",     "expected": false }
  ]
}
