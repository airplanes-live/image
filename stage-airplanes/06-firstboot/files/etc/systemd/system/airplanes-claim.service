[Unit]
Description=airplanes.live feeder claim registration
ConditionPathExists=!/etc/airplanes/feeder-claim-secret
# Wait for network-online.target so the first attempt has DNS reachable
# instead of failing with curl rc=6 and parking in `failed` state until
# the next timer fire. On this image NetworkManager-wait-online is
# already pulled into boot by other services, so the marginal boot cost
# is zero; on a network-less Pi the target's wait-online consumer times
# out (default 60s) and Wants= ensures we still run afterwards.
After=airplanes-first-run.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/apl-feed claim register
# Transient network failures (curl DNS / connect / timeout) return 75
# (EX_TEMPFAIL) from apl-feed claim register. Treating that as success
# keeps the unit out of `failed` state so the timer's OnUnitActiveSec=5min
# re-arms cleanly; exit 2 stays reserved for argv / config errors that a
# retry can't fix.
SuccessExitStatus=75

# Sandboxing. The unit must run as root (writes /etc/airplanes/ and chowns
# the resulting claim-state files to airplanes-feed:airplanes-feed; the dir
# stays root-owned because feed.env is shell-sourced as root by update.sh
# and a daemon-writable /etc/airplanes/ would let a compromised airplanes-
# feed escalate via planted shell metacharacters in feed.env). The
# directives below shrink the blast radius of root for this oneshot.
ProtectSystem=strict
ReadWritePaths=/etc/airplanes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Network for HTTPS POST to airplanes.live, AF_UNIX for nsswitch / journal.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# CAP_CHOWN: chown_claim_state hands the secret over to
# airplanes-feed:airplanes-feed.
# CAP_FOWNER: write_secret_file chmods 0640 AFTER chowning, so the chmod
# target is owned by airplanes-feed (not root) — without CAP_FOWNER, root
# can't change the mode on a non-owned file.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
# On a retry where a previous register left a pending file behind,
# claim_register reads the pending file (mode 0640 group=airplanes-feed)
# before re-publishing. Without group membership, root would need
# CAP_DAC_READ_SEARCH; SupplementaryGroups is the surgical fix.
SupplementaryGroups=airplanes-feed
