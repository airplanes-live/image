[Unit]
Description=airplanes.live first-run setup
ConditionPathExists=!/var/lib/airplanes/first-run-done
# Run BEFORE NetworkManager so the WiFi keyfile generated from
# /boot/firmware/airplanes-config.txt (WIFI_SSID/PASS/COUNTRY) is in place
# when NM starts and autoconnects. After=systemd-rfkill.service keeps us
# behind the rfkill state restore. feed.env merge / feeder-id / 978 toggle
# are all local file ops that don't need network either.
#
# Before=avahi-daemon.service lighttpd.service so apply_hostname's
# /etc/hostname + hostnamectl run before mDNS broadcasts the system name and
# before lighttpd serves its first response with hostname-derived headers.
After=local-fs.target systemd-rfkill.service
Before=NetworkManager.service network-pre.target avahi-daemon.service lighttpd.service
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/airplanes-first-run

# Sandboxing. The unit runs as root because /etc/airplanes/ is root-owned
# (deliberately — see airplanes-claim.service for the trust-boundary
# rationale around feed.env). The directives below shrink the blast radius
# of root for this oneshot.
#
# ProtectSystem=full: /usr, /boot, /efi mounted read-only; /etc, /var, /run
# stay writable. The script and feed/create-uuid.sh write across many
# /etc subdirs (airplanes/, hostname, hosts, NetworkManager/system-
# connections/, wpa_supplicant/, default/) and need atomic temp+rename in
# /etc itself; ProtectSystem=strict would require enumerating each path
# (and raspi-config's WiFi-country path may touch more), which is brittle.
# /usr stays read-only via full; the legacy /usr/local/share/airplanes/
# airplanes-uuid symlink is unblocked by ReadWritePaths.
ProtectSystem=full
ReadWritePaths=/usr/local/share/airplanes
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_UNIX for journal + dbus (apply_hostname calls hostnamectl which sends
# a dbus message to systemd-hostnamed). PrivateNetwork=yes is defense in
# depth — the only AF that's allowed is local IPC anyway, but explicitly
# disabling network namespace participation makes the contract obvious.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
# Empty bounding set: with hostnamectl as the primary path, the dbus IPC
# does the privileged work in systemd-hostnamed. The fallback `hostname`
# binary (sethostname(2), needs CAP_SYS_ADMIN) silently fails under this
# bounding set; airplanes-first-run already has `|| true` on that path so
# it doesn't abort the unit. raspi-config's WiFi-country path (needs
# CAP_NET_ADMIN for `iw`, plus writes to /boot/firmware/cmdline.txt) also
# fails; the script's documented fallback writes /etc/wpa_supplicant/
# wpa_supplicant.conf directly, which doesn't need any capability.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
