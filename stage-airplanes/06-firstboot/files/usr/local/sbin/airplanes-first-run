#!/bin/bash
# First-boot setup for the airplanes.live feeder image.
#
# Runs once (gated on /var/lib/airplanes/first-run-done) to:
#   1. Generate /etc/airplanes/feeder-id via the feed-shipped create-uuid.sh
#   2. Merge user-set values from /boot/firmware/airplanes-config.txt into
#      /etc/airplanes/feed.env (atomic, flock-protected, sentinel-tolerant)
#   3. Drop the done marker so subsequent boots are no-ops
#
# Failures in step 1 or 2 are logged and tolerated so a partially-edited
# config doesn't trap the feeder in a boot loop. The marker is dropped
# unconditionally because retries on subsequent boots cannot improve anything
# the user hasn't fixed in the boot config.

FEED_ENV="/etc/airplanes/feed.env"
BOOT_CONFIG="/boot/firmware/airplanes-config.txt"
LOCK_FILE="/var/lock/airplanes-feed-env.lock"
DONE_MARKER="/var/lib/airplanes/first-run-done"
CREATE_UUID="/usr/local/share/airplanes/git/create-uuid.sh"
WIFI_KEYFILE_DIR="${WIFI_KEYFILE_DIR:-/etc/NetworkManager/system-connections}"
WIFI_KEYFILE="${WIFI_KEYFILE:-${WIFI_KEYFILE_DIR}/airplanes-config-wifi.nmconnection}"
HOSTNAME_FILE="${HOSTNAME_FILE:-/etc/hostname}"
HOSTS_FILE="${HOSTS_FILE:-/etc/hosts}"

# Sentinel values map to "user has not configured this" — they exist so the
# template parses, not so they get propagated into feed.env. MLAT_USER is
# not sentinel-gated: the template ships a friendly default
# (airplanes-live-image) that we want propagated so unconfigured feeders
# show identifiably on the MLAT map instead of as the generic placeholder.
declare -gA SENTINELS=(
	[LATITUDE]=0
	[LONGITUDE]=0
	[ALTITUDE]=0m
	[DUMP978]=no
)

# FEED_HOST shorthand: when set, expand_feed_host derives both MLATSERVER and
# TARGET from one hostname so users editing airplanes-config.txt cannot leak
# half of the traffic to production by setting only one of the two endpoints.
declare -g FEED_HOST_DEFAULT_MLAT_PORT="31090"
declare -g FEED_HOST_DEFAULT_BEAST_PORT="30004"

log() {
	if command -v logger >/dev/null 2>&1; then
		logger -t airplanes-first-run -- "$*"
	else
		echo "airplanes-first-run: $*" >&2
	fi
}

generate_feeder_id() {
	if [[ ! -f "$CREATE_UUID" ]]; then
		log "create-uuid.sh missing at $CREATE_UUID; skipping feeder-id generation"
		return 1
	fi
	if ! bash "$CREATE_UUID"; then
		log "create-uuid.sh exited non-zero"
		return 1
	fi
}

# parse_boot_config FILE -> populates the BOOT_CFG associative array.
# Tolerates UTF-8 BOM, CRLF line endings, KEY=value, KEY="value", blank lines,
# and #-prefixed comments. Refuses to source the file (untrusted input).
declare -gA BOOT_CFG=()
parse_boot_config() {
	BOOT_CFG=()
	local file="$1" first=1 line key value
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%$'\r'}"
		if (( first )); then
			line="${line#$'\xef\xbb\xbf'}"
			first=0
		fi
		[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
		if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
			key="${BASH_REMATCH[1]}"
			value="${BASH_REMATCH[2]}"
			if [[ "$value" =~ ^\"(.*)\"$ ]]; then
				value="${BASH_REMATCH[1]}"
			else
				value="${value#"${value%%[![:space:]]*}"}"
				value="${value%"${value##*[![:space:]]}"}"
			fi
			[[ -z "$value" ]] && continue
			if [[ -v "SENTINELS[$key]" && "${SENTINELS[$key]}" == "$value" ]]; then
				continue
			fi
			# Shell-metachar reject is for values that get sourced into bash via
			# feed.env. WIFI_* values are written into an NM keyfile (line-based,
			# not eval'd) so common password chars like $ and \ are safe there.
			if [[ "$key" != WIFI_* && "$value" == *[\"\\\$\`]* ]]; then
				log "rejecting unsafe value for $key in boot config"
				continue
			fi
			BOOT_CFG[$key]="$value"
		fi
	done < "$file"
}

# Validate WiFi inputs against NM/WPA constraints. SSID 1-32 bytes; PSK is
# either 8-63 ASCII chars or exactly 64 hex chars; COUNTRY is ISO 3166-1
# alpha-2 (two uppercase letters). Returns 0 if values are usable (or
# WIFI_SSID is empty), 1 if SSID was supplied but invalid. Bad PSK / COUNTRY
# is non-fatal — the corresponding parameter is dropped and a warning logged.
declare -g _WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
validate_wifi_inputs() {
	_WIFI_SSID="${BOOT_CFG[WIFI_SSID]:-}"
	_WIFI_PASS="${BOOT_CFG[WIFI_PASS]:-}"
	_WIFI_COUNTRY="${BOOT_CFG[WIFI_COUNTRY]:-}"

	if [[ -n "$_WIFI_SSID" ]]; then
		local ssid_bytes
		ssid_bytes="$(LC_ALL=C printf '%s' "$_WIFI_SSID" | wc -c)"
		if (( ssid_bytes < 1 || ssid_bytes > 32 )); then
			log "WIFI_SSID length $ssid_bytes invalid (must be 1-32 bytes); ignoring WiFi config"
			_WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
			return 1
		fi
	fi

	if [[ -n "$_WIFI_PASS" ]]; then
		local pass_len="${#_WIFI_PASS}"
		# Either 64-char hex PSK or 8-63 char ASCII passphrase.
		if [[ "$_WIFI_PASS" =~ ^[A-Fa-f0-9]{64}$ ]]; then
			:
		elif (( pass_len >= 8 && pass_len <= 63 )); then
			:
		else
			log "WIFI_PASS length $pass_len invalid (need 8-63 chars or 64 hex); ignoring WiFi config"
			_WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
			return 1
		fi
	fi

	if [[ -n "$_WIFI_COUNTRY" ]] && [[ ! "$_WIFI_COUNTRY" =~ ^[A-Z]{2}$ ]]; then
		log "WIFI_COUNTRY=$_WIFI_COUNTRY invalid (need ISO 3166-1 alpha-2 like DE); dropping country"
		_WIFI_COUNTRY=""
	fi
	return 0
}

# Pop every WIFI_* key from BOOT_CFG so they can never be merged into
# feed.env. Validates the recognized keys via validate_wifi_inputs and warns
# about typos like WIFI_PASSWORD that might otherwise leak secrets.
consume_wifi_config() {
	validate_wifi_inputs || true

	local key
	for key in "${!BOOT_CFG[@]}"; do
		[[ "$key" == WIFI_* ]] || continue
		case "$key" in
			WIFI_SSID|WIFI_PASS|WIFI_COUNTRY) ;;
			*) log "ignoring unrecognized WiFi key $key (typo? use WIFI_SSID / WIFI_PASS / WIFI_COUNTRY)" ;;
		esac
		unset "BOOT_CFG[$key]"
	done
}

# Write /etc/NetworkManager/system-connections/airplanes-config-wifi.nmconnection
# atomically. Idempotent: existing keyfile is replaced. If WIFI_SSID is empty,
# do nothing. Returns non-zero only on hard write failure.
write_nm_keyfile() {
	[[ -n "$_WIFI_SSID" ]] || return 0

	local uuid tmp
	uuid="$(cat /proc/sys/kernel/random/uuid)" || {
		log "failed to read /proc/sys/kernel/random/uuid"
		return 1
	}

	if ! install -d -m 0700 "$WIFI_KEYFILE_DIR" 2>/dev/null; then
		log "failed to create $WIFI_KEYFILE_DIR"
		return 1
	fi
	# Best-effort root ownership; in test mode (non-root) this is a no-op.
	[[ "$(id -u)" -eq 0 ]] && chown root:root "$WIFI_KEYFILE_DIR" 2>/dev/null

	tmp="$(mktemp "${WIFI_KEYFILE_DIR}/.airplanes-wifi.tmp.XXXXXX")" || {
		log "failed to mktemp under $WIFI_KEYFILE_DIR"
		return 1
	}
	trap '[[ -n "${tmp:-}" && -e "$tmp" ]] && rm -f "$tmp"' RETURN

	{
		printf '[connection]\n'
		printf 'id=airplanes-config-wifi\n'
		printf 'uuid=%s\n' "$uuid"
		printf 'type=wifi\n'
		printf 'autoconnect=true\n'
		printf '\n'
		printf '[wifi]\n'
		printf 'ssid=%s\n' "$_WIFI_SSID"
		printf 'mode=infrastructure\n'
		printf '\n'
		if [[ -n "$_WIFI_PASS" ]]; then
			printf '[wifi-security]\n'
			printf 'key-mgmt=wpa-psk\n'
			printf 'psk=%s\n' "$_WIFI_PASS"
			printf '\n'
		fi
		printf '[ipv4]\n'
		printf 'method=auto\n'
		printf '\n'
		printf '[ipv6]\n'
		printf 'method=auto\n'
	} > "$tmp" || {
		log "failed to write keyfile body"
		return 1
	}

	chmod 0600 "$tmp" || {
		log "failed to chmod 0600 keyfile temp"
		return 1
	}
	[[ "$(id -u)" -eq 0 ]] && chown root:root "$tmp" 2>/dev/null

	sync -d "$tmp" 2>/dev/null || sync
	if ! mv -fT "$tmp" "$WIFI_KEYFILE"; then
		log "failed to rename keyfile into place"
		return 1
	fi
	tmp=""
	sync "$WIFI_KEYFILE_DIR" 2>/dev/null || sync
}

# Apply the WiFi country code via raspi-config's nonint helper. raspi-config
# writes the right combination of /etc/wpa_supplicant/wpa_supplicant.conf,
# /etc/default/crda, kernel cmdline (rfkill state), and applies it via iw.
# Falls back to a minimal wpa_supplicant.conf write if raspi-config isn't
# available, preserving any existing content.
apply_wifi_country() {
	[[ -n "$_WIFI_COUNTRY" ]] || return 0

	if command -v raspi-config >/dev/null 2>&1; then
		if raspi-config nonint do_wifi_country "$_WIFI_COUNTRY" >/dev/null 2>&1; then
			return 0
		fi
		log "raspi-config nonint do_wifi_country $_WIFI_COUNTRY failed; falling back"
	fi

	local wpa=/etc/wpa_supplicant/wpa_supplicant.conf
	install -d -m 0755 /etc/wpa_supplicant 2>/dev/null
	local tmp_wpa
	tmp_wpa="$(mktemp /etc/wpa_supplicant/.wpa.tmp.XXXXXX)" || return 1
	if [[ -f "$wpa" ]]; then
		grep -v '^country=' "$wpa" > "$tmp_wpa" || true
	fi
	printf 'country=%s\n' "$_WIFI_COUNTRY" >> "$tmp_wpa"
	chmod 0644 "$tmp_wpa"
	mv -fT "$tmp_wpa" "$wpa" || { rm -f "$tmp_wpa"; return 1; }
}

# RFC 1123 single-label hostname: 1-63 bytes, alnum, internal hyphens
# allowed, no leading/trailing hyphen. Reserved names (localhost) rejected
# case-insensitively because setting them as the system hostname breaks
# NSS resolution and other local-loopback assumptions.
_hostname_valid() {
	local h="$1"
	(( ${#h} >= 1 && ${#h} <= 63 )) || return 1
	[[ "$h" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
	[[ "${h,,}" != localhost ]] || return 1
	return 0
}

# Set the system hostname from BOOT_CFG[HOSTNAME] if specified. Updates
# /etc/hostname (atomic write), the 127.0.1.1 entry in /etc/hosts (preserving
# aliases), and the live kernel hostname (so avahi-daemon broadcasts the
# right name on the same boot). HOSTNAME is a synthetic key — stripped from
# BOOT_CFG up front so it never lands in feed.env even on subsequent failure.
#
# Format: a single-label RFC 1123 hostname (1-63 bytes, letters/digits/hyphens,
# no leading or trailing hyphen, no dots). Multi-label names like foo.local
# are rejected — mDNS adds .local automatically; multi-feeder users want
# short names like 'airplanes-feeder' or 'feeder1' here.
#
# Skips the /etc/hostname write when it already matches HOSTNAME (idempotent),
# but always runs the /etc/hosts rewrite + runtime apply so a partial prior
# run that left /etc/hosts stale gets repaired on the next first-boot.
apply_hostname() {
	local raw="${BOOT_CFG[HOSTNAME]:-}"
	[[ -n "$raw" ]] || return 0

	if ! _hostname_valid "$raw"; then
		log "rejecting invalid HOSTNAME=$raw (need 1-63 char RFC 1123 single-label hostname; not 'localhost'; no .local suffix — mDNS adds it)"
		unset 'BOOT_CFG[HOSTNAME]'
		return 0
	fi

	# Strip up front — the key is synthetic, so any subsequent failure must
	# not leak it into feed.env via merge_feed_env.
	unset 'BOOT_CFG[HOSTNAME]'

	# Read current hostname (first line only, CR/LF stripped). Validate it
	# before using as a search key for the /etc/hosts rewrite — if it's not
	# a sane hostname (multi-line, commented, weird whitespace), we skip the
	# /etc/hosts pass rather than risk concatenating into a wrong rewrite.
	local current=""
	if [[ -f "$HOSTNAME_FILE" ]]; then
		current="$(head -n1 -- "$HOSTNAME_FILE" | tr -d '\r\n')"
		if ! _hostname_valid "$current"; then
			log "ignoring untrusted current hostname '$current' from $HOSTNAME_FILE; skipping $HOSTS_FILE rewrite"
			current=""
		fi
	fi

	# /etc/hostname: atomic write, only if changed. Failures here are hard:
	# without a written /etc/hostname the boot is in an inconsistent state we
	# can't reason about, so return non-zero to surface the failure to main().
	if [[ "$current" != "$raw" ]]; then
		local tmp_hn
		tmp_hn="$(mktemp "${HOSTNAME_FILE}.tmp.XXXXXX")" || {
			log "failed mktemp for $HOSTNAME_FILE"
			return 1
		}
		if ! printf '%s\n' "$raw" > "$tmp_hn"; then
			rm -f -- "$tmp_hn"
			log "failed writing $HOSTNAME_FILE tmp"
			return 1
		fi
		if ! chmod 0644 -- "$tmp_hn"; then
			rm -f -- "$tmp_hn"
			log "failed chmod on $HOSTNAME_FILE tmp"
			return 1
		fi
		if ! mv -fT -- "$tmp_hn" "$HOSTNAME_FILE"; then
			rm -f -- "$tmp_hn"
			log "failed renaming $HOSTNAME_FILE"
			return 1
		fi
	fi

	# /etc/hosts: rewrite the 127.0.1.1 line whose hostname matches `current`.
	# Run even when /etc/hostname was idempotent so a partial prior run that
	# left /etc/hosts pointing at the old name gets repaired.
	#
	# `current` is validated to alnum + internal hyphens, so it contains no
	# sed metacharacters. Use sed for byte-faithful rewrite of non-matching
	# lines (the previous bash line-by-line emit could add a trailing newline
	# to files that didn't have one and could land a partial file on ENOSPC
	# during the loop).
	if [[ -n "$current" && -f "$HOSTS_FILE" ]]; then
		local tmp_hosts
		if tmp_hosts="$(mktemp "${HOSTS_FILE}.tmp.XXXXXX")"; then
			if sed -E "s/^(127\\.0\\.1\\.1[[:space:]]+)${current}([[:space:]]|$)/\\1${raw}\\2/" -- "$HOSTS_FILE" > "$tmp_hosts" \
				&& chmod 0644 -- "$tmp_hosts"; then
				if ! mv -fT -- "$tmp_hosts" "$HOSTS_FILE"; then
					rm -f -- "$tmp_hosts"
					log "failed renaming $HOSTS_FILE"
				fi
			else
				rm -f -- "$tmp_hosts"
				log "failed transforming $HOSTS_FILE; leaving original in place"
			fi
		else
			log "failed mktemp for $HOSTS_FILE; runtime hostname apply continues"
		fi
	fi

	# Apply for the running session so daemons that read the hostname at
	# startup (avahi-daemon for mDNS broadcasts, lighttpd for self-references)
	# see the new value. Run unconditionally — /etc/hostname is the canonical
	# source for next-boot, so the kernel-hostname change is the same-boot
	# signal that needs to land regardless of /etc/hosts state.
	if command -v hostnamectl >/dev/null 2>&1; then
		hostnamectl set-hostname "$raw" 2>/dev/null || true
	fi
	# Legacy fallback when systemd-hostnamed isn't running (chroot-mode
	# tests, recovery contexts).
	if command -v hostname >/dev/null 2>&1; then
		hostname "$raw" 2>/dev/null || true
	fi
}

# Synthesize MLATSERVER and TARGET from a user-friendly FEED_HOST shorthand.
# FEED_HOST itself is a synthetic key — not consumed by airplanes-feed.sh /
# airplanes-mlat.sh — so we strip it from BOOT_CFG after expansion. (A
# pre-existing FEED_HOST= line in feed.env on disk is preserved by
# merge_feed_env's generic preserve-unknown-keys behavior; that's harmless
# since feed scripts don't read FEED_HOST.)
#
# Format: hostname or IPv4, optionally with :port (1..65535). The :port (if
# given) applies to MLATSERVER; TARGET always uses the well-known beast port
# 30004. Users needing IPv6 (bracket form) or non-default beast ports must
# set MLATSERVER and TARGET directly — those overrides win over FEED_HOST-
# derived defaults so advanced setups (multi-host fan-out, etc.) still work
# alongside FEED_HOST.
#
# Validation: this is a shell-safety gate, not a strict DNS validator. The
# regex rejects shell metacharacters and shapes that would produce malformed
# argv (e.g. spaces, embedded ';'); it does NOT reject every malformed
# hostname (e.g. 'bad..example', '_x.example', or labels >63 bytes). Such
# inputs pass shell gating, then fail cleanly at resolver time with a clear
# journalctl error. Conversely, webconfig's universalReject (configspec.go:53)
# will re-check the synthesized values when the user later edits LATITUDE /
# USER / etc. via the UI; failing loudly at first boot beats silently
# poisoning feed.env into a state webconfig refuses to write to.
#
# Asymmetric-leak guard: when FEED_HOST is present but invalid, the user has
# opted into the safe single-knob path and that path failed. Falling back to
# a half-set MLATSERVER (or half-set TARGET) is the exact asymmetric-routing
# leak FEED_HOST exists to prevent — so we drop a lone explicit endpoint
# override in that case. A matched pair (both MLATSERVER and TARGET set
# explicitly) is preserved: that's a self-contained advanced override.
expand_feed_host() {
	local raw host port
	raw="${BOOT_CFG[FEED_HOST]:-}"
	[[ -n "$raw" ]] || return 0

	if ! _feed_host_is_valid "$raw"; then
		log "rejecting invalid FEED_HOST=$raw (need hostname or hostname:port with port 1-65535; bracketed IPv6 is not supported via FEED_HOST — set MLATSERVER and TARGET directly instead)"
		unset 'BOOT_CFG[FEED_HOST]'
		_feed_host_drop_lone_override
		return 0
	fi

	if [[ "$raw" == *:* ]]; then
		host="${raw%:*}"
		port="${raw##*:}"
	else
		host="$raw"
		port="$FEED_HOST_DEFAULT_MLAT_PORT"
	fi

	[[ -v "BOOT_CFG[MLATSERVER]" ]] || BOOT_CFG[MLATSERVER]="${host}:${port}"
	[[ -v "BOOT_CFG[TARGET]" ]] || BOOT_CFG[TARGET]="--net-connector ${host},${FEED_HOST_DEFAULT_BEAST_PORT},beast_reduce_plus_out"

	unset 'BOOT_CFG[FEED_HOST]'
}

# Returns 0 if the argument is an acceptable FEED_HOST value. Splits structure
# from the main path so port-range validation lives next to its consumer.
_feed_host_is_valid() {
	local raw="$1" port
	(( ${#raw} <= 253 )) || return 1
	[[ "$raw" =~ ^[A-Za-z0-9._-]+(:[0-9]+)?$ ]] || return 1
	if [[ "$raw" == *:* ]]; then
		port="${raw##*:}"
		# Strip leading zeros to dodge bash's "value too great for base"
		# error on octal interpretation (e.g. port="08").
		port="${port#"${port%%[!0]*}"}"
		[[ -z "$port" ]] && port=0
		(( port >= 1 && port <= 65535 )) || return 1
	fi
	return 0
}

# When FEED_HOST validation fails, drop a lone MLATSERVER or lone TARGET
# override to prevent asymmetric routing. A matched pair stays — that's a
# self-contained advanced override the user wrote intentionally.
_feed_host_drop_lone_override() {
	local has_mlat=0 has_target=0
	[[ -v "BOOT_CFG[MLATSERVER]" ]] && has_mlat=1
	[[ -v "BOOT_CFG[TARGET]" ]] && has_target=1
	if (( has_mlat != has_target )); then
		(( has_mlat )) && unset 'BOOT_CFG[MLATSERVER]'
		(( has_target )) && unset 'BOOT_CFG[TARGET]'
		log "dropped lone endpoint override after FEED_HOST rejection (avoiding asymmetric routing)"
	fi
}

# Translate a legacy USER= entry in BOOT_CFG into the new MLAT_USER /
# MLAT_ENABLED schema. Idempotent: if the boot config sets either of the new
# keys, those win and any USER= is dropped (the boot template is the user's
# edit surface and we never want both schemas living together in feed.env).
#
# Legacy mapping mirrors update.sh's migrate_user_to_mlat_split:
#   USER=0 or USER=disable  → MLAT_USER="", MLAT_ENABLED=false
#   USER=<other>            → MLAT_USER=<value>, MLAT_ENABLED=true
apply_user_to_mlat_split() {
	if [[ -v "BOOT_CFG[MLAT_USER]" || -v "BOOT_CFG[MLAT_ENABLED]" ]]; then
		# Explicit new schema wins; drop any legacy USER alongside it.
		unset 'BOOT_CFG[USER]' 2>/dev/null || true
		return 0
	fi
	if [[ ! -v "BOOT_CFG[USER]" ]]; then
		return 0
	fi
	case "${BOOT_CFG[USER]}" in
		0|disable)
			BOOT_CFG[MLAT_USER]=""
			BOOT_CFG[MLAT_ENABLED]="false"
			;;
		*)
			BOOT_CFG[MLAT_USER]="${BOOT_CFG[USER]}"
			BOOT_CFG[MLAT_ENABLED]="true"
			;;
	esac
	unset 'BOOT_CFG[USER]'
}

# Atomic merge under flock: write a tmp file in the target directory, fsync
# it, rename onto feed.env, then sync the parent directory. The flock makes
# concurrent webconfig writes impossible during first-run.
merge_feed_env() {
	(
		flock -x 9
		local feed_env_dir tmp_env emitted=""
		feed_env_dir="$(dirname "$FEED_ENV")"
		tmp_env="$(mktemp "${feed_env_dir}/feed.env.tmp.XXXXXX")"

		if [[ -f "$FEED_ENV" ]]; then
			local line key
			while IFS= read -r line || [[ -n "$line" ]]; do
				if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]]; then
					key="${BASH_REMATCH[1]}"
					if [[ -v "BOOT_CFG[$key]" ]]; then
						printf '%s="%s"\n' "$key" "${BOOT_CFG[$key]}" >> "$tmp_env"
						emitted+=" $key "
						continue
					fi
				fi
				printf '%s\n' "$line" >> "$tmp_env"
			done < "$FEED_ENV"
		fi

		local key
		for key in "${!BOOT_CFG[@]}"; do
			if [[ "$emitted" != *" $key "* ]]; then
				printf '%s="%s"\n' "$key" "${BOOT_CFG[$key]}" >> "$tmp_env"
			fi
		done

		sync -d "$tmp_env" 2>/dev/null || sync
		mv "$tmp_env" "$FEED_ENV"
		sync "$feed_env_dir" 2>/dev/null || sync
	) 9>"$LOCK_FILE"
}

# Enable + start (non-blocking) the 978 services iff DUMP978=yes (literal). The
# units are After=airplanes-first-run.service, so a blocking `enable --now`
# would deadlock — start jobs queue and run after this script exits.
toggle_978_services() {
	[[ "${BOOT_CFG[DUMP978]:-no}" != "yes" ]] && return 0
	if ! systemctl enable dump978-fa.service airplanes-978.service; then
		log "failed to enable 978 services"
		return 1
	fi
	if ! systemctl start --no-block dump978-fa.service airplanes-978.service; then
		log "failed to queue 978 service starts"
		return 1
	fi
}

main() {
	set -u
	generate_feeder_id || true

	if [[ -f "$BOOT_CONFIG" ]]; then
		if ! parse_boot_config "$BOOT_CONFIG"; then
			log "failed to parse $BOOT_CONFIG; leaving feed.env untouched"
		else
			# WiFi pass: pop WIFI_* keys and write the NM keyfile + country
			# BEFORE merge_feed_env so secrets can never reach feed.env even on
			# typoed keys.
			consume_wifi_config
			if ! write_nm_keyfile; then
				log "failed to write WiFi keyfile; continuing"
			fi
			if ! apply_wifi_country; then
				log "failed to apply WiFi country code; continuing"
			fi
			apply_hostname || true
			expand_feed_host
			apply_user_to_mlat_split
			if (( ${#BOOT_CFG[@]} > 0 )); then
				if ! merge_feed_env; then
					log "failed to merge boot config into $FEED_ENV"
				fi
			fi
		fi
		toggle_978_services || true
	fi

	mkdir -p "$(dirname "$DONE_MARKER")"
	: > "$DONE_MARKER"
	sync
	return 0
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
