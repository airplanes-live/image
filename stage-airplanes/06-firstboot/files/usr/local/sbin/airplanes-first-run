#!/bin/bash
# First-boot setup for the airplanes.live feeder image.
#
# Runs every boot. Two responsibilities:
#   1. Generate /etc/airplanes/feeder-id (skipped when one already exists,
#      so a later boot can't mint a fresh UUID over a still-valid one and
#      orphan the claim secret tied to it).
#   2. If /boot/firmware/airplanes-config.txt is present: parse + apply
#      (NM keyfile, WiFi country, hostname, FEED_HOST expansion, feed.env
#      merge) → rename the source to airplanes-config.applied.txt on full
#      success. Any unknown key (rejected at parse time against the 6-key
#      allowlist), user-input rejection, sub-step write failure, or merge
#      failure leaves the source in place and writes a sibling
#      airplanes-config.error.txt naming what to fix; the source is then
#      re-applied on the next boot.
#
# Successful applies clear any stale airplanes-config.error.txt. Empty /
# comment-only files are still "consumed" (rename, no merge), since the
# user explicitly placed them.

FEED_ENV="${FEED_ENV:-/etc/airplanes/feed.env}"
BOOT_CONFIG="${BOOT_CONFIG:-/boot/firmware/airplanes-config.txt}"
LOCK_FILE="${LOCK_FILE:-/run/airplanes/feed-env.lock}"
FEEDER_ID_FILE="${FEEDER_ID_FILE:-/etc/airplanes/feeder-id}"
WIFI_KEYFILE_DIR="${WIFI_KEYFILE_DIR:-/etc/NetworkManager/system-connections}"
WIFI_KEYFILE="${WIFI_KEYFILE:-${WIFI_KEYFILE_DIR}/airplanes-config-wifi.nmconnection}"
HOSTNAME_FILE="${HOSTNAME_FILE:-/etc/hostname}"
HOSTS_FILE="${HOSTS_FILE:-/etc/hosts}"

# Per-device SSH opt-in (SSH_PASSWORD / SSH_PUBKEY). The password snippet is a
# Match-scoped sshd drop-in shared byte-for-byte with webconfig's apl-ssh
# helper; the pubkey lands in a managed authorized_keys file under /etc (the
# 90-airplanes.conf AuthorizedKeysFile additionally lists this dir for %u).
SSHD_PI_PWAUTH_CONF="${SSHD_PI_PWAUTH_CONF:-/etc/ssh/sshd_config.d/99-airplanes-ssh-pi.conf}"
SSH_AUTH_KEYS_DIR="${SSH_AUTH_KEYS_DIR:-/etc/ssh/authorized_keys.d}"
SSH_PI_AUTH_KEYS="${SSH_PI_AUTH_KEYS:-${SSH_AUTH_KEYS_DIR}/pi}"
SSH_MIN_PASSWORD_LEN="${SSH_MIN_PASSWORD_LEN:-12}"

# Shared Wi-Fi predicate + keyfile-writer libraries, also consumed by
# /usr/local/bin/apl-wifi (webconfig flow). The libs ship from
# airplanes-live/image-webconfig via the runtime overlay; production install
# location is /opt/airplanes/current/lib/airplanes. Bats tests point
# APL_WIFI_LIB_DIR at the image-webconfig source checkout
# (AIRPLANES_IMAGE_WEBCONFIG_ROOT in CI).
APL_WIFI_LIB_DIR="${APL_WIFI_LIB_DIR:-/opt/airplanes/current/lib/airplanes}"
# shellcheck source=/dev/null
. "$APL_WIFI_LIB_DIR/wifi-validators.sh"
# shellcheck source=/dev/null
. "$APL_WIFI_LIB_DIR/wifi-keyfile.sh"

# FEED_HOST shorthand: when set, expand_feed_host derives both MLATSERVER and
# TARGET from one hostname so users editing airplanes-config.txt cannot leak
# half of the traffic to production by setting only one of the two endpoints.
declare -g FEED_HOST_DEFAULT_MLAT_PORT="31090"
declare -g FEED_HOST_DEFAULT_BEAST_PORT="30004"

# Errors collected during the apply pass. write_error_file() serializes this
# into /boot/firmware/airplanes-config.error.txt. main() gates the rename on
# this being empty.
#
# Callers MUST NOT include secret values (WIFI_PASS) in the message — name
# the key only. WIFI_SSID is not strictly secret but names networks; same rule.
declare -ga BOOT_CFG_ERRORS=()

log() {
	if command -v logger >/dev/null 2>&1; then
		logger -t airplanes-first-run -- "$*"
	else
		echo "airplanes-first-run: $*" >&2
	fi
}

# Logs to journal AND appends to BOOT_CFG_ERRORS. Use for user-input
# rejection and sub-step failures that should surface in
# airplanes-config.error.txt. Use plain log() for informational notes
# (e.g. raspi-config → wpa_supplicant fallback transitions).
record_error() {
	BOOT_CFG_ERRORS+=("$1")
	log "$1"
}

# The keys airplanes-config.txt accepts. Operational config (location,
# MLAT name, MLAT on/off, gain, UAT toggling) lives in the webconfig UI;
# feed.env-only knobs (MLATSERVER, TARGET, INPUT, SDR pinning, etc.) are
# edited directly on the booted feeder. reject_unknown_boot_key emits a
# category-specific error so airplanes-config.error.txt tells the user where
# the setting actually lives. WEBSITE_URL is the non-prod backend pointer
# (claim + diagnostics + remote config sync); FEED_HOST is the ingest /
# MLAT endpoint — independent keys, both bootstrap-only.
#
# SSH_PASSWORD / SSH_PUBKEY are synthetic per-device SSH opt-in keys: consumed
# by apply_ssh_password / apply_ssh_pubkey and stripped from BOOT_CFG before
# merge_feed_env so they NEVER reach feed.env. SSH_PASSWORD's cleartext is also
# redacted from the FAT source at apply time (see apply_ssh_password).
declare -gA BOOT_CFG_ALLOWLIST=(
	[WIFI_SSID]=1 [WIFI_PASS]=1 [WIFI_COUNTRY]=1
	[HOSTNAME]=1
	[FEED_HOST]=1
	[WEBSITE_URL]=1
	[SSH_PASSWORD]=1 [SSH_PUBKEY]=1
)

# Keys webconfig writes via POST /api/config (mirror of configspec.go
# WriteKeys). Any of these in airplanes-config.txt should redirect the user
# to the UI rather than the feed.env-edit path.
declare -gA _BOOT_CFG_WEBCONFIG_KEYS=(
	[LATITUDE]=1 [LONGITUDE]=1 [ALTITUDE]=1
	[MLAT_USER]=1 [MLAT_ENABLED]=1
	[GAIN]=1 [UAT_INPUT]=1
)

# Set by reject_unknown_boot_key when it rejects a WIFI_* typo. consume_wifi_config
# inspects this and drops all _WIFI_* state on a true value — without that, a
# typo like WIFI_PASSWORD="..." paired with a valid WIFI_SSID would still produce
# an NM keyfile (open network, no [wifi-security] block) because the typo was
# stripped at parse time before validate_wifi_inputs could see it. Dropping the
# whole WiFi block on any WIFI_* typo keeps the contract: either ALL three keys
# land correctly or NONE do.
declare -g _WIFI_TYPO_REJECTED=0

# Emit a category-specific allowlist-rejection error. Caller must already
# know the key is outside BOOT_CFG_ALLOWLIST. Three buckets:
#   - WIFI_* typos → "use WIFI_SSID / WIFI_PASS / WIFI_COUNTRY" (preserves
#     the secret-safe phrasing of the previous typo guard; never echoes the
#     value). Also flips _WIFI_TYPO_REJECTED so consume_wifi_config drops the
#     whole WiFi block — preventing a WIFI_PASSWORD typo from silently
#     downgrading a WPA SSID to an open-network keyfile.
#   - configspec.go WriteKeys → "use the webconfig UI" (these are the keys
#     the UI's form actually writes).
#   - everything else (MLATSERVER, TARGET, INPUT, INPUT_TYPE, READSB_SDR_*,
#     DUMP978*, legacy USER, etc.) → "edit /etc/airplanes/feed.env on the
#     booted feeder" (webconfig doesn't write them, so pointing at the UI
#     would be wrong).
reject_unknown_boot_key() {
	local key="$1" lineno="$2"
	if [[ "$key" == WIFI_* ]]; then
		_WIFI_TYPO_REJECTED=1
		record_error "line $lineno: unrecognized WiFi key $key (use WIFI_SSID, WIFI_PASS, or WIFI_COUNTRY)"
	elif [[ -n "${_BOOT_CFG_WEBCONFIG_KEYS[$key]:-}" ]]; then
		record_error "line $lineno: $key is configured via the webconfig UI at http://<hostname>.local/ after first boot, not airplanes-config.txt"
	else
		record_error "line $lineno: $key is not configurable via airplanes-config.txt — SSH in and edit /etc/airplanes/feed.env on the booted feeder if you need this setting"
	fi
}

# Skip if a canonical feeder-id already exists: regenerating would mint a fresh
# UUID on every boot, and if the canonical file were ever corrupted while a
# claim secret still referenced the old UUID, that would silently rotate the
# feeder's identity.
generate_feeder_id() {
	if [[ -f "$FEEDER_ID_FILE" ]]; then
		return 0
	fi
	log "generating feeder-id"
	local uuid
	uuid="$(cat /proc/sys/kernel/random/uuid)" || {
		log "failed to read /proc/sys/kernel/random/uuid"
		return 1
	}
	local etc_dir
	etc_dir="$(dirname "$FEEDER_ID_FILE")"
	mkdir -p "$etc_dir"
	local tmp="$FEEDER_ID_FILE.$$"
	printf '%s\n' "$uuid" > "$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$FEEDER_ID_FILE"
	log "feeder-id=$uuid"
}

# Verify the BOOT_CONFIG directory accepts create/rename/unlink before any
# state-mutating step. If FAT is unwritable (sandbox misconfig or mount
# state), we bail without touching feed.env — otherwise a merged feed.env
# without a successful rename would trigger re-application on every boot.
preflight_boot_dir_writable() {
	local dir probe
	dir="$(dirname "$BOOT_CONFIG")"
	probe="$(mktemp "$dir/.airplanes-fr-probe.XXXXXX" 2>/dev/null)" || return 1
	rm -f -- "$probe" 2>/dev/null || return 1
	return 0
}

# parse_boot_config FILE -> populates the BOOT_CFG associative array.
# Tolerates UTF-8 BOM, CRLF line endings, KEY=value, KEY="value", blank lines,
# and #-prefixed comments. Refuses to source the file (untrusted input).
declare -gA BOOT_CFG=()
parse_boot_config() {
	BOOT_CFG=()
	_WIFI_TYPO_REJECTED=0
	local file="$1" first=1 line key value lineno=0
	while IFS= read -r line || [[ -n "$line" ]]; do
		lineno=$((lineno + 1))
		line="${line%$'\r'}"
		if (( first )); then
			line="${line#$'\xef\xbb\xbf'}"
			first=0
		fi
		[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
		if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
			key="${BASH_REMATCH[1]}"
			value="${BASH_REMATCH[2]}"
			# Allowlist gate fires FIRST — before the quote strip, before the
			# empty-value skip, and before the shell-metachar reject — so any
			# non-allowlisted key lands the category-specific "where this
			# setting actually lives" error. Without this ordering, UAT_INPUT=
			# would be silently dropped by the empty-value skip and
			# USER=$(rm -rf /) would be misreported as "unsafe value" rather
			# than "not configurable here."
			if [[ -z "${BOOT_CFG_ALLOWLIST[$key]:-}" ]]; then
				reject_unknown_boot_key "$key" "$lineno"
				continue
			fi
			if [[ "$value" =~ ^\"(.*)\"$ ]]; then
				value="${BASH_REMATCH[1]}"
			else
				value="${value#"${value%%[![:space:]]*}"}"
				value="${value%"${value##*[![:space:]]}"}"
			fi
			[[ -z "$value" ]] && continue
			# Shell-metachar reject is for values that get sourced into bash via
			# feed.env. WIFI_* values are written into an NM keyfile (line-based,
			# not eval'd) so common password chars like $ and \ are safe there.
			# SSH_PASSWORD is piped to chpasswd over stdin and SSH_PUBKEY is
			# written to a keyfile — neither is ever sourced into feed.env, so
			# password chars like $ \ " are legitimate and must be accepted.
			if [[ "$key" != WIFI_* && "$key" != SSH_PASSWORD && "$key" != SSH_PUBKEY \
				&& "$value" == *[\"\\\$\`]* ]]; then
				record_error "line $lineno: rejecting unsafe value for $key (contains shell metacharacter)"
				continue
			fi
			BOOT_CFG[$key]="$value"
		else
			# Non-blank, non-comment, but didn't match KEY=value.
			record_error "line $lineno: malformed; expected KEY=value"
		fi
	done < "$file"
}

# Validate WiFi inputs against NM/WPA constraints. SSID 1-32 bytes; PSK is
# either 8-63 printable ASCII or exactly 64 hex chars; COUNTRY is ISO 3166-1
# alpha-2. Predicate bodies live in wifi-validators.sh (shared with apl-wifi).
# On rejection: log an error to BOOT_CFG_ERRORS (no values, only key names)
# and drop the offending input so write_nm_keyfile becomes a no-op.
declare -g _WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
validate_wifi_inputs() {
	_WIFI_SSID="${BOOT_CFG[WIFI_SSID]:-}"
	_WIFI_PASS="${BOOT_CFG[WIFI_PASS]:-}"
	_WIFI_COUNTRY="${BOOT_CFG[WIFI_COUNTRY]:-}"

	if [[ -n "$_WIFI_SSID" ]] && ! apl_wifi_valid_ssid "$_WIFI_SSID"; then
		record_error "WIFI_SSID: invalid (must be 1-32 bytes, no control characters); WiFi config dropped"
		_WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
		return 1
	fi

	if [[ -n "$_WIFI_PASS" ]] && ! apl_wifi_valid_psk "$_WIFI_PASS"; then
		# Never include the value or its length-derived guess — keep this
		# message free of anything that could narrow the secret.
		record_error "WIFI_PASS: invalid (expected 8-63 printable ASCII characters or 64 hex characters); WiFi config dropped"
		_WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
		return 1
	fi

	if [[ -n "$_WIFI_COUNTRY" ]] && ! apl_wifi_valid_country "$_WIFI_COUNTRY"; then
		record_error "WIFI_COUNTRY: invalid value (need ISO 3166-1 alpha-2 like DE); dropping country"
		_WIFI_COUNTRY=""
	fi
	return 0
}

# Pop every WIFI_* key from BOOT_CFG so they can never reach feed.env (WiFi
# credentials belong in the NM keyfile, not in a shell-sourced env file).
# parse_boot_config's allowlist already rejects WIFI_PASSWORD and other
# WIFI_* typos with the secret-safe "use WIFI_SSID / WIFI_PASS / WIFI_COUNTRY"
# message before they enter BOOT_CFG; this sweep is defense in depth in case
# future code seeds BOOT_CFG by some other path.
#
# If _WIFI_TYPO_REJECTED is set (parse-time saw a WIFI_* typo like
# WIFI_PASSWORD), drop _WIFI_SSID / _WIFI_PASS / _WIFI_COUNTRY so write_nm_keyfile
# becomes a no-op. Otherwise a typo like WIFI_SSID=... + WIFI_PASSWORD=... would
# write an open-network keyfile for the SSID — silently downgrading the user's
# intended WPA connection to open (which an attacker could SSID-spoof). The
# error file already names the typo; the right repair is "fix and reboot,"
# not "join the wrong network in the meantime."
consume_wifi_config() {
	validate_wifi_inputs || true

	if (( _WIFI_TYPO_REJECTED )); then
		_WIFI_SSID="" _WIFI_PASS="" _WIFI_COUNTRY=""
	fi

	local key
	for key in "${!BOOT_CFG[@]}"; do
		if [[ "$key" == WIFI_* ]]; then
			unset "BOOT_CFG[$key]"
		fi
	done
	return 0
}

# Write /etc/NetworkManager/system-connections/airplanes-config-wifi.nmconnection
# atomically. Idempotent: existing keyfile is replaced. If WIFI_SSID is empty,
# do nothing. Returns non-zero only on hard write failure. The atomic write +
# body composition lives in wifi-keyfile.sh (shared with apl-wifi); first-run
# always emits autoconnect=true and priority=0, matching the legacy keyfile.
write_nm_keyfile() {
	[[ -n "$_WIFI_SSID" ]] || return 0

	local uuid
	uuid="$(cat /proc/sys/kernel/random/uuid)" || {
		log "failed to read /proc/sys/kernel/random/uuid"
		return 1
	}

	if ! apl_wifi_write_keyfile \
		"$WIFI_KEYFILE" \
		"airplanes-config-wifi" \
		"$uuid" \
		"$_WIFI_SSID" \
		"$_WIFI_PASS" \
		"false" \
		0 \
		"true"; then
		log "failed to write WiFi keyfile"
		return 1
	fi
	return 0
}

# Apply the WiFi country code via raspi-config's nonint helper. raspi-config
# writes the right combination of /etc/wpa_supplicant/wpa_supplicant.conf,
# /etc/default/crda, kernel cmdline (rfkill state), and applies it via iw.
# Falls back to a minimal wpa_supplicant.conf write if raspi-config isn't
# available, preserving any existing content.
apply_wifi_country() {
	[[ -n "$_WIFI_COUNTRY" ]] || return 0

	if command -v raspi-config >/dev/null 2>&1; then
		if raspi-config nonint do_wifi_country "$_WIFI_COUNTRY" >/dev/null 2>&1; then
			return 0
		fi
		log "raspi-config nonint do_wifi_country $_WIFI_COUNTRY failed; falling back"
	fi

	local wpa=/etc/wpa_supplicant/wpa_supplicant.conf
	install -d -m 0755 /etc/wpa_supplicant 2>/dev/null
	local tmp_wpa
	tmp_wpa="$(mktemp /etc/wpa_supplicant/.wpa.tmp.XXXXXX)" || return 1
	if [[ -f "$wpa" ]]; then
		grep -v '^country=' "$wpa" > "$tmp_wpa" || true
	fi
	printf 'country=%s\n' "$_WIFI_COUNTRY" >> "$tmp_wpa"
	chmod 0644 "$tmp_wpa"
	mv -fT "$tmp_wpa" "$wpa" || { rm -f "$tmp_wpa"; return 1; }
}

# RFC 1123 single-label hostname: 1-63 bytes, alnum, internal hyphens
# allowed, no leading/trailing hyphen. Reserved names (localhost) rejected
# case-insensitively because setting them as the system hostname breaks
# NSS resolution and other local-loopback assumptions.
_hostname_valid() {
	local h="$1"
	(( ${#h} >= 1 && ${#h} <= 63 )) || return 1
	[[ "$h" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
	[[ "${h,,}" != localhost ]] || return 1
	return 0
}

# Set the system hostname from BOOT_CFG[HOSTNAME] if specified. Updates
# /etc/hostname (atomic write), the 127.0.1.1 entry in /etc/hosts (preserving
# aliases), and the live kernel hostname (so avahi-daemon broadcasts the
# right name on the same boot). HOSTNAME is a synthetic key — stripped from
# BOOT_CFG up front so it never lands in feed.env even on subsequent failure.
#
# Format: a single-label RFC 1123 hostname (1-63 bytes, letters/digits/hyphens,
# no leading or trailing hyphen, no dots). Multi-label names like foo.local
# are rejected — mDNS adds .local automatically; multi-feeder users want
# short names like 'airplanes-feeder' or 'feeder1' here.
#
# Skips the /etc/hostname write when it already matches HOSTNAME (idempotent),
# but always runs the /etc/hosts rewrite + runtime apply so a partial prior
# run that left /etc/hosts stale gets repaired on the next first-boot.
apply_hostname() {
	local raw="${BOOT_CFG[HOSTNAME]:-}"
	[[ -n "$raw" ]] || return 0

	if ! _hostname_valid "$raw"; then
		record_error "HOSTNAME: invalid value '$raw' (need 1-63 char RFC 1123 single-label name; not 'localhost'; no .local suffix — mDNS adds it)"
		unset 'BOOT_CFG[HOSTNAME]'
		return 0
	fi

	# Strip up front — the key is synthetic, so any subsequent failure must
	# not leak it into feed.env via merge_feed_env.
	unset 'BOOT_CFG[HOSTNAME]'

	# Read current hostname (first line only, CR/LF stripped). Validate it
	# before using as a search key for the /etc/hosts rewrite — if it's not
	# a sane hostname (multi-line, commented, weird whitespace), we skip the
	# /etc/hosts pass rather than risk concatenating into a wrong rewrite.
	local current=""
	if [[ -f "$HOSTNAME_FILE" ]]; then
		current="$(head -n1 -- "$HOSTNAME_FILE" | tr -d '\r\n')"
		if ! _hostname_valid "$current"; then
			log "ignoring untrusted current hostname '$current' from $HOSTNAME_FILE; skipping $HOSTS_FILE rewrite"
			current=""
		fi
	fi

	# /etc/hostname: atomic write, only if changed. Failures here are hard:
	# without a written /etc/hostname the boot is in an inconsistent state we
	# can't reason about, so return non-zero to surface the failure to main().
	if [[ "$current" != "$raw" ]]; then
		local tmp_hn
		tmp_hn="$(mktemp "${HOSTNAME_FILE}.tmp.XXXXXX")" || {
			log "failed mktemp for $HOSTNAME_FILE"
			return 1
		}
		if ! printf '%s\n' "$raw" > "$tmp_hn"; then
			rm -f -- "$tmp_hn"
			log "failed writing $HOSTNAME_FILE tmp"
			return 1
		fi
		if ! chmod 0644 -- "$tmp_hn"; then
			rm -f -- "$tmp_hn"
			log "failed chmod on $HOSTNAME_FILE tmp"
			return 1
		fi
		if ! mv -fT -- "$tmp_hn" "$HOSTNAME_FILE"; then
			rm -f -- "$tmp_hn"
			log "failed renaming $HOSTNAME_FILE"
			return 1
		fi
	fi

	# /etc/hosts: rewrite the 127.0.1.1 line whose hostname matches `current`.
	# Run even when /etc/hostname was idempotent so a partial prior run that
	# left /etc/hosts pointing at the old name gets repaired.
	#
	# `current` is validated to alnum + internal hyphens, so it contains no
	# sed metacharacters. Use sed for byte-faithful rewrite of non-matching
	# lines (the previous bash line-by-line emit could add a trailing newline
	# to files that didn't have one and could land a partial file on ENOSPC
	# during the loop).
	if [[ -n "$current" && -f "$HOSTS_FILE" ]]; then
		local tmp_hosts
		if tmp_hosts="$(mktemp "${HOSTS_FILE}.tmp.XXXXXX")"; then
			if sed -E "s/^(127\\.0\\.1\\.1[[:space:]]+)${current}([[:space:]]|$)/\\1${raw}\\2/" -- "$HOSTS_FILE" > "$tmp_hosts" \
				&& chmod 0644 -- "$tmp_hosts"; then
				if ! mv -fT -- "$tmp_hosts" "$HOSTS_FILE"; then
					rm -f -- "$tmp_hosts"
					record_error "failed renaming $HOSTS_FILE"
				fi
			else
				rm -f -- "$tmp_hosts"
				record_error "failed transforming $HOSTS_FILE; leaving original in place"
			fi
		else
			record_error "failed mktemp for $HOSTS_FILE; runtime hostname apply continues"
		fi
	fi

	# Apply for the running session so daemons that read the hostname at
	# startup (avahi-daemon for mDNS broadcasts, lighttpd for self-references)
	# see the new value. Run unconditionally — /etc/hostname is the canonical
	# source for next-boot, so the kernel-hostname change is the same-boot
	# signal that needs to land regardless of /etc/hosts state.
	if command -v hostnamectl >/dev/null 2>&1; then
		hostnamectl set-hostname "$raw" 2>/dev/null || true
	fi
	# Legacy fallback when systemd-hostnamed isn't running (chroot-mode
	# tests, recovery contexts).
	if command -v hostname >/dev/null 2>&1; then
		hostname "$raw" 2>/dev/null || true
	fi
}

# Synthesize MLATSERVER and TARGET from a user-friendly FEED_HOST shorthand.
# FEED_HOST itself is a synthetic key — not consumed by airplanes-feed.sh /
# airplanes-mlat.sh — so we strip it from BOOT_CFG after expansion. MLATSERVER
# and TARGET aren't in BOOT_CFG_ALLOWLIST, so the user can never set them
# directly from the boot config; the synthesis is the only way they enter
# BOOT_CFG, which means we always overwrite unconditionally and never need
# to guard against a user override.
#
# Format: hostname or IPv4, optionally with :port (1..65535). The :port (if
# given) applies to MLATSERVER; TARGET always uses the well-known beast port
# 30004. Bracketed IPv6, non-default beast port, multi-host fan-out, and
# other advanced topologies are not expressible from the SD card — SSH in
# after first boot and edit /etc/airplanes/feed.env directly for those cases.
#
# Validation is a shell-safety gate, not a strict DNS validator. The regex
# rejects shell metacharacters and shapes that would produce malformed argv
# (e.g. spaces, embedded ';'); it does NOT reject every malformed hostname
# (e.g. 'bad..example', '_x.example', or labels >63 bytes). Such inputs pass
# shell gating, then fail cleanly at resolver time with a clear journalctl
# error. Conversely, webconfig's universalReject (configspec.go:53) re-checks
# the synthesized values when the user later edits via the UI; failing loudly
# at first boot beats silently poisoning feed.env into a state webconfig
# refuses to write to.
expand_feed_host() {
	local raw host port
	raw="${BOOT_CFG[FEED_HOST]:-}"
	[[ -n "$raw" ]] || return 0

	if ! _feed_host_is_valid "$raw"; then
		record_error "FEED_HOST: invalid value '$raw' (need hostname or hostname:port with port 1-65535; bracketed IPv6 / non-default beast port / multi-host fan-out are not expressible via FEED_HOST — SSH in after first boot and edit /etc/airplanes/feed.env directly for advanced topologies)"
		unset 'BOOT_CFG[FEED_HOST]'
		return 0
	fi

	if [[ "$raw" == *:* ]]; then
		host="${raw%:*}"
		port="${raw##*:}"
	else
		host="$raw"
		port="$FEED_HOST_DEFAULT_MLAT_PORT"
	fi

	BOOT_CFG[MLATSERVER]="${host}:${port}"
	BOOT_CFG[TARGET]="--net-connector ${host},${FEED_HOST_DEFAULT_BEAST_PORT},beast_reduce_plus_out"

	unset 'BOOT_CFG[FEED_HOST]'
}

# Returns 0 if the argument is an acceptable FEED_HOST value. Splits structure
# from the main path so port-range validation lives next to its consumer.
_feed_host_is_valid() {
	local raw="$1" port
	(( ${#raw} <= 253 )) || return 1
	[[ "$raw" =~ ^[A-Za-z0-9._-]+(:[0-9]+)?$ ]] || return 1
	if [[ "$raw" == *:* ]]; then
		port="${raw##*:}"
		# Strip leading zeros to dodge bash's "value too great for base"
		# error on octal interpretation (e.g. port="08").
		port="${port#"${port%%[!0]*}"}"
		[[ -z "$port" ]] && port=0
		(( port >= 1 && port <= 65535 )) || return 1
	fi
	return 0
}

# Synthesize APL_FEED_WEBSITE_URL from a user-friendly WEBSITE_URL shorthand.
# WEBSITE_URL is the non-prod backend pointer (claim + diagnostics + remote
# config sync); apl-feed reads APL_FEED_WEBSITE_URL out of feed.env via its
# resolver. The boot-config key name itself must not leak into feed.env, so
# we strip it from BOOT_CFG after expansion (parallel to FEED_HOST's
# MLATSERVER+TARGET synthesis).
#
# Normalises trailing-slash so "http://host/" doesn't produce double-slashes
# in downstream "$WEBSITE_URL/api/..." concatenations.
expand_website_url() {
	local raw="${BOOT_CFG[WEBSITE_URL]:-}"
	[[ -n "$raw" ]] || return 0

	if ! _website_url_is_valid "$raw"; then
		record_error "WEBSITE_URL: invalid value '$raw' (need http://host or https://host, optionally :port (1-65535) and /path; no userinfo, query, or fragment)"
		unset 'BOOT_CFG[WEBSITE_URL]'
		return 0
	fi

	# Strip a single trailing slash on the path portion. Leave bare-scheme
	# "http://" pathological cases to _website_url_is_valid (rejected).
	if [[ "$raw" == */ && "$raw" != *://*/*/ ]]; then
		# raw matches "http(s)://host[/]"; the only trailing slash is the
		# one right after the authority. Strip it so concatenation lands
		# cleanly.
		raw="${raw%/}"
	elif [[ "$raw" == */ ]]; then
		# Path with extra trailing slash: "http://host/api/" -> drop one.
		raw="${raw%/}"
	fi

	BOOT_CFG[APL_FEED_WEBSITE_URL]="$raw"
	unset 'BOOT_CFG[WEBSITE_URL]'
}

# Returns 0 if the argument is an acceptable WEBSITE_URL value. Tighter than
# FEED_HOST's validator because the URL ends up shell-sourced from feed.env
# AND re-scanned by apl-feed's feed-env-apply universal-reject — bytes the
# parser admits here that the universal-reject would later trip on would
# block every future config-sync rewrite. Explicitly rejected: userinfo
# (user@), query strings (?), fragments (#), shell metacharacters
# ($, `, \, "), and whitespace.
_website_url_is_valid() {
	local raw="$1" rest scheme hostport host port path
	(( ${#raw} <= 2048 )) || return 1

	# Scheme.
	if [[ "$raw" == https://* ]]; then
		scheme="https"
		rest="${raw#https://}"
	elif [[ "$raw" == http://* ]]; then
		scheme="http"
		rest="${raw#http://}"
	else
		return 1
	fi
	[[ -n "$rest" ]] || return 1
	# scheme is validated above; silence shellcheck.
	: "$scheme"

	# No userinfo, query, or fragment. The feed-env-apply universal-reject
	# treats some of these (esp. #) as forbidden bytes anyway.
	[[ "$rest" == *@* ]] && return 1
	[[ "$rest" == *\?* ]] && return 1
	[[ "$rest" == *#* ]] && return 1

	# Authority before first slash; path after (optional).
	if [[ "$rest" == */* ]]; then
		hostport="${rest%%/*}"
		path="/${rest#*/}"
	else
		hostport="$rest"
		path=""
	fi
	[[ -n "$hostport" ]] || return 1

	# Split host:port. We treat the LAST `:` as the port separator. Bracketed
	# IPv6 literals are not supported here — same posture as FEED_HOST.
	if [[ "$hostport" == *:* ]]; then
		host="${hostport%:*}"
		port="${hostport##*:}"
	else
		host="$hostport"
		port=""
	fi
	[[ -n "$host" ]] || return 1
	(( ${#host} <= 253 )) || return 1

	# Host: dotted-IPv4 or hostname-shaped (RFC 1123 letters/digits/dot/dash).
	# Loose enough to admit single-label LAN names like `homelab` and
	# IPv4 like `192.168.1.10`; strict on shell-safety.
	[[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
	if [[ "$host" =~ ^[0-9.]+$ ]]; then
		# Looks like an IPv4 candidate — validate octets.
		local IFS=.
		# shellcheck disable=SC2206  # intentional word-split on dots
		local octets=( $host )
		(( ${#octets[@]} == 4 )) || return 1
		local o
		for o in "${octets[@]}"; do
			[[ "$o" =~ ^[0-9]+$ ]] || return 1
			# Strip leading zeros to dodge octal-interpretation.
			o="${o#"${o%%[!0]*}"}"
			[[ -z "$o" ]] && o=0
			(( o >= 0 && o <= 255 )) || return 1
		done
	fi

	# Port: 1..65535 if present.
	if [[ -n "$port" ]]; then
		[[ "$port" =~ ^[0-9]+$ ]] || return 1
		port="${port#"${port%%[!0]*}"}"
		[[ -z "$port" ]] && port=0
		(( port >= 1 && port <= 65535 )) || return 1
	fi

	# Path (optional): conservative allowlist that survives both the shell
	# source in apl-feed/airplanes-feed.sh and feed-env-apply's universal-
	# reject. % accepts percent-encoded bytes.
	if [[ -n "$path" ]]; then
		[[ "$path" =~ ^[A-Za-z0-9._~%/-]*$ ]] || return 1
	fi

	return 0
}

# Redact the SSH_PASSWORD line from the on-FAT source file in place, decoupled
# from the success rename. Called the instant the password is applied so a
# LATER apply-step failure (e.g. FEED_HOST) that keeps the source for retry can
# never leave cleartext on the FAT partition. Replaces the matching
# `SSH_PASSWORD=...` line (commented or not) with a redaction marker, preserving
# every other byte/line in order. Atomic: tmp in the same dir + mv -fT.
#
# Matches a SSH_PASSWORD assignment with optional leading whitespace and an
# optional leading '#'. SSH_PUBKEY is public and is deliberately NOT touched.
redact_ssh_password_source() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	grep -Eq '^[[:space:]]*#?[[:space:]]*SSH_PASSWORD=' "$file" || return 0

	local dir tmp
	dir="$(dirname "$file")"
	tmp="$(mktemp "$dir/.airplanes-redact.tmp.XXXXXX")" || {
		log "failed mktemp to redact SSH_PASSWORD from $file"
		return 1
	}
	# sed-free, byte-faithful line rewrite: emit every line unchanged except
	# the SSH_PASSWORD assignment, which becomes a fixed marker. read -r keeps
	# backslashes literal; the final `|| [[ -n "$line" ]]` preserves a missing
	# trailing newline only when the source lacked one.
	local line wrote_nl=1
	{
		while IFS= read -r line || { wrote_nl=0; [[ -n "$line" ]]; }; do
			if [[ "$line" =~ ^[[:space:]]*#?[[:space:]]*SSH_PASSWORD= ]]; then
				printf '%s\n' "# SSH_PASSWORD applied and redacted"
			elif (( wrote_nl )); then
				printf '%s\n' "$line"
			else
				printf '%s' "$line"
			fi
		done
	} < "$file" > "$tmp" || { rm -f -- "$tmp"; return 1; }

	if [[ -f "$file" ]]; then
		chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0644 "$tmp" 2>/dev/null || true
	fi
	sync -d "$tmp" 2>/dev/null || sync
	if ! mv -fT "$tmp" "$file"; then
		rm -f -- "$tmp"
		log "failed renaming redacted $file"
		return 1
	fi
	sync "$dir" 2>/dev/null || sync
	return 0
}

# Apply SSH_PASSWORD: set the pi account's password and enable Match-scoped
# password SSH for pi only. SSH_PASSWORD is synthetic — stripped from BOOT_CFG
# so it can never reach feed.env. The cleartext is redacted from the FAT source
# at apply time (not gated on the later success rename), so a subsequent
# apply-step failure that keeps the source for retry leaves no password on disk.
#
# Secret-safe: never echo the password value — record_error names the key only.
apply_ssh_password() {
	local pw="${BOOT_CFG[SSH_PASSWORD]:-}"
	[[ -n "$pw" ]] || return 0

	# Strip up front: synthetic key must not leak into feed.env even if a
	# validation failure returns early below.
	unset 'BOOT_CFG[SSH_PASSWORD]'

	# Redact the cleartext from the FAT source BEFORE touching any credential or
	# enabling password SSH — so we can never leave password auth on while the
	# password still sits in cleartext on the SD card. If redaction fails, refuse
	# to enable SSH at all (the value stays only in this process's memory).
	if ! redact_ssh_password_source "$BOOT_CONFIG"; then
		record_error "SSH_PASSWORD: could not redact the source file; not enabling password SSH"
		return 0
	fi

	# Reject C0/DEL control bytes: a newline would inject a second user:password
	# record into chpasswd's line-based stdin (e.g. setting root's password). The
	# line-based boot-config parser already prevents a literal newline reaching
	# here; this is defense in depth, matching the webconfig validator.
	local _pw_total _pw_stripped
	_pw_total="$(LC_ALL=C printf '%s' "$pw" | wc -c)"
	_pw_stripped="$(LC_ALL=C printf '%s' "$pw" | LC_ALL=C tr -d '\000-\037\177' | wc -c)"
	if [[ "$_pw_total" != "$_pw_stripped" ]]; then
		record_error "SSH_PASSWORD: contains control characters"
		return 0
	fi

	if (( ${#pw} < SSH_MIN_PASSWORD_LEN )); then
		record_error "SSH_PASSWORD: too short (need at least ${SSH_MIN_PASSWORD_LEN} characters)"
		return 0
	fi

	# Set the pi account password. printf|chpasswd keeps the value off argv and
	# out of any process listing; only the key name is ever logged. chpasswd
	# runs as root and writes the root-owned /etc/shadow, so DAC checks pass
	# without any capability — fine under the unit's empty CapabilityBoundingSet.
	# (If a future systemd hardening change ever breaks this, pre-hash with
	# `openssl passwd -6` and feed `chpasswd -e` instead, which needs no extra
	# privilege either.)
	if ! printf 'pi:%s\n' "$pw" | chpasswd; then
		record_error "SSH_PASSWORD: failed to set the pi account password"
		return 0
	fi

	# Drop the shared opt-in snippet enabling password SSH for pi only.
	if ! write_ssh_pi_pwauth_snippet; then
		record_error "SSH_PASSWORD: failed to write $SSHD_PI_PWAUTH_CONF"
		return 0
	fi

	# Belt-and-suspenders for the re-apply-on-later-boot path: nudge sshd to
	# reload so the snippet takes effect without waiting for the next sshd
	# start. Best-effort — the unit ordering (Before=ssh.service) already
	# covers the first-boot case, and the sandbox may refuse the reload.
	systemctl reload ssh 2>/dev/null || true
	return 0
}

# Write the shared 99-airplanes-ssh-pi.conf snippet (byte-identical with
# webconfig's apl-ssh helper). Atomic: tmp in the same dir + mv -fT, 0644
# root:root. Match User pi keeps the password-auth opt-in scoped to pi so other
# users retain the 90-airplanes.conf PasswordAuthentication-no default.
write_ssh_pi_pwauth_snippet() {
	local dir tmp
	dir="$(dirname "$SSHD_PI_PWAUTH_CONF")"
	install -d -m 0755 "$dir" 2>/dev/null || true
	tmp="$(mktemp "$dir/.airplanes-ssh-pi.tmp.XXXXXX")" || return 1
	cat > "$tmp" <<'EOF' || { rm -f -- "$tmp"; return 1; }
# airplanes.live per-device opt-in: enables password SSH for the pi account
# only (Match-scoped, so other users keep the 90-airplanes.conf default of
# PasswordAuthentication no). Written by airplanes-first-run (boot config) and
# webconfig's apl-ssh helper.
Match User pi
    PasswordAuthentication yes
Match all
EOF
	chmod 0644 "$tmp" 2>/dev/null || true
	chown root:root "$tmp" 2>/dev/null || true
	if ! mv -fT "$tmp" "$SSHD_PI_PWAUTH_CONF"; then
		rm -f -- "$tmp"
		return 1
	fi
	return 0
}

# Apply SSH_PUBKEY: validate it looks like an OpenSSH public key, then
# atomically OVERWRITE the managed authorized_keys file for pi
# (/etc/ssh/authorized_keys.d/pi), single key, 0644 root:root. SSH_PUBKEY is
# synthetic — stripped from BOOT_CFG so it never reaches feed.env. The key is
# public, so on a validation failure record_error may name the key without
# leaking a secret (kept terse anyway).
apply_ssh_pubkey() {
	local key="${BOOT_CFG[SSH_PUBKEY]:-}"
	[[ -n "$key" ]] || return 0

	unset 'BOOT_CFG[SSH_PUBKEY]'

	if ! _ssh_pubkey_is_valid "$key"; then
		record_error "SSH_PUBKEY: invalid (need an OpenSSH public key, e.g. 'ssh-ed25519 AAAA... comment')"
		return 0
	fi

	install -d -m 0755 "$SSH_AUTH_KEYS_DIR" 2>/dev/null || true
	local tmp
	tmp="$(mktemp "$SSH_AUTH_KEYS_DIR/.airplanes-pi-keys.tmp.XXXXXX")" || {
		record_error "SSH_PUBKEY: failed to stage the managed pi authorized_keys file"
		return 0
	}
	if ! printf '%s\n' "$key" > "$tmp"; then
		rm -f -- "$tmp"
		record_error "SSH_PUBKEY: failed to write the managed pi authorized_keys file"
		return 0
	fi
	chmod 0644 "$tmp" 2>/dev/null || true
	chown root:root "$tmp" 2>/dev/null || true
	if ! mv -fT "$tmp" "$SSH_PI_AUTH_KEYS"; then
		rm -f -- "$tmp"
		record_error "SSH_PUBKEY: failed to install $SSH_PI_AUTH_KEYS"
		return 0
	fi
	return 0
}

# Returns 0 if the argument looks like an OpenSSH public key: a known type
# token followed by a base64 blob (optional trailing comment ignored). This is
# a shape gate, not a cryptographic validation — sshd is the final authority on
# whether the blob decodes to a usable key.
_ssh_pubkey_is_valid() {
	local raw="$1" type blob
	# Split into the first two whitespace-separated fields.
	read -r type blob _ <<< "$raw"
	[[ -n "$type" && -n "$blob" ]] || return 1
	case "$type" in
		ssh-ed25519 | ssh-rsa | \
		ecdsa-sha2-nistp256 | ecdsa-sha2-nistp384 | ecdsa-sha2-nistp521 | \
		sk-ssh-ed25519@openssh.com | sk-ecdsa-sha2-nistp256@openssh.com) ;;
		*) return 1 ;;
	esac
	# base64 blob: A-Z a-z 0-9 + / with optional = padding, non-empty.
	[[ "$blob" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || return 1
	return 0
}

# Atomic merge under flock: write a tmp file in the target directory, fsync
# it, rename onto feed.env, then sync the parent directory. The flock matches
# webconfig's apply-config (/run/airplanes/feed-env.lock) so a concurrent
# webconfig write can never interleave — though first-run is ordered
# Before=lighttpd.service so contention is theoretical.
merge_feed_env() {
	(
		flock -x 9 || return 1
		local feed_env_dir tmp_env emitted="" line key
		feed_env_dir="$(dirname "$FEED_ENV")"
		tmp_env="$(mktemp "${feed_env_dir}/feed.env.tmp.XXXXXX")" || return 1

		if [[ -f "$FEED_ENV" ]]; then
			while IFS= read -r line || [[ -n "$line" ]]; do
				if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]]; then
					key="${BASH_REMATCH[1]}"
					if [[ -v "BOOT_CFG[$key]" ]]; then
						if ! printf '%s="%s"\n' "$key" "${BOOT_CFG[$key]}" >> "$tmp_env"; then
							rm -f -- "$tmp_env"
							return 1
						fi
						emitted+=" $key "
						continue
					fi
				fi
				if ! printf '%s\n' "$line" >> "$tmp_env"; then
					rm -f -- "$tmp_env"
					return 1
				fi
			done < "$FEED_ENV"
		fi

		for key in "${!BOOT_CFG[@]}"; do
			if [[ "$emitted" != *" $key "* ]]; then
				if ! printf '%s="%s"\n' "$key" "${BOOT_CFG[$key]}" >> "$tmp_env"; then
					rm -f -- "$tmp_env"
					return 1
				fi
			fi
		done

		# Preserve mode/owner from the existing feed.env so the
		# airplanes-feed user can still source it after the rename. mktemp
		# defaults to 0600 root:root, which silently breaks `User=airplanes-feed`
		# units on the next read. Same pattern feed-env-apply uses for
		# config-sync rewrites.
		if [[ -f "$FEED_ENV" ]]; then
			chmod --reference="$FEED_ENV" "$tmp_env" 2>/dev/null || chmod 0644 "$tmp_env" || true
			chown --reference="$FEED_ENV" "$tmp_env" 2>/dev/null || true
		else
			chmod 0644 "$tmp_env" 2>/dev/null || true
		fi

		sync -d "$tmp_env" 2>/dev/null || sync
		if ! mv "$tmp_env" "$FEED_ENV"; then
			rm -f -- "$tmp_env"
			return 1
		fi
		sync "$feed_env_dir" 2>/dev/null || sync
		return 0
	) 9>"$LOCK_FILE"
}

# Rename BOOT_CONFIG → airplanes-config.applied.txt atomically. Clears any
# stale airplanes-config.error.txt as part of the success step. mv -fT is
# atomic within the same directory on FAT32. Caller (main) must only invoke
# this after every other apply step succeeded.
consume_boot_config() {
	local applied="${BOOT_CONFIG%.txt}.applied.txt"
	local errfile="${BOOT_CONFIG%.txt}.error.txt"
	if ! mv -fT "$BOOT_CONFIG" "$applied"; then
		record_error "rename to ${applied##*/} failed; original file kept for retry"
		return 1
	fi
	[[ -f "$errfile" ]] && rm -f -- "$errfile"
	sync "$(dirname "$BOOT_CONFIG")" 2>/dev/null || sync
	return 0
}

# Atomic write of airplanes-config.error.txt next to BOOT_CONFIG. Renders the
# BOOT_CFG_ERRORS array as a human-readable diagnostic. Temp file in the same
# FAT dir so mv -fT is atomic.
#
# This function is the only writer to airplanes-config.error.txt; callers
# never echo BOOT_CFG_ERRORS contents elsewhere. record_error() callers must
# not include secret values (WIFI_PASS) in messages.
write_error_file() {
	local errfile="${BOOT_CONFIG%.txt}.error.txt"
	local dir tmp
	dir="$(dirname "$errfile")"
	tmp="$(mktemp "$dir/.airplanes-error.tmp.XXXXXX")" || return 1
	{
		printf '%s\n' "airplanes.live first-run config was not fully applied."
		printf '\n'
		printf 'Source: %s\n' "$BOOT_CONFIG"
		printf 'Status: error\n'
		printf '\n'
		printf '%s\n' "Fix the items below, keep the file named airplanes-config.txt, then reboot."
		printf '%s\n' "On success this file is removed and airplanes-config.txt is renamed to"
		printf '%s\n' "airplanes-config.applied.txt."
		printf '\n'
		printf 'Errors:\n'
		local err
		for err in "${BOOT_CFG_ERRORS[@]}"; do
			printf -- '- %s\n' "$err"
		done
	} > "$tmp" || { rm -f -- "$tmp"; return 1; }
	chmod 0644 "$tmp" 2>/dev/null || true
	if ! mv -fT "$tmp" "$errfile"; then
		rm -f -- "$tmp"
		return 1
	fi
	sync "$dir" 2>/dev/null || sync
	return 0
}

main() {
	set -u
	BOOT_CFG_ERRORS=()
	generate_feeder_id || true

	[[ -f "$BOOT_CONFIG" ]] || return 0

	if ! preflight_boot_dir_writable; then
		log "$(dirname "$BOOT_CONFIG") not writable; skipping boot-config apply"
		return 0
	fi

	if ! parse_boot_config "$BOOT_CONFIG"; then
		record_error "failed to parse $BOOT_CONFIG"
		write_error_file || log "failed to write error file"
		return 0
	fi

	# WiFi pass: pop WIFI_* keys and write the NM keyfile + country BEFORE
	# merge_feed_env so secrets can never reach feed.env even on typoed keys.
	consume_wifi_config
	write_nm_keyfile || record_error "failed to write WiFi keyfile"
	apply_wifi_country || record_error "failed to apply WiFi country code"
	apply_hostname || record_error "failed to apply hostname"
	# SSH opt-in: set the pi password (+ pwauth snippet) and/or install the pi
	# pubkey. Both strip their synthetic keys from BOOT_CFG so they can never
	# reach feed.env; apply_ssh_password redacts the cleartext from the FAT
	# source at apply time regardless of whether later steps succeed.
	apply_ssh_password
	apply_ssh_pubkey
	expand_feed_host
	expand_website_url

	local merge_ok=1
	if (( ${#BOOT_CFG[@]} > 0 )); then
		merge_feed_env || { record_error "failed to merge boot config into $FEED_ENV"; merge_ok=0; }
	fi

	if (( merge_ok )) && (( ${#BOOT_CFG_ERRORS[@]} == 0 )); then
		if ! consume_boot_config; then
			write_error_file || log "failed to write error file"
		fi
	else
		write_error_file || log "failed to write error file"
	fi
	return 0
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
