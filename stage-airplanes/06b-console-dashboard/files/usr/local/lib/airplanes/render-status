#!/bin/bash
# Render the airplanes.live feeder status dashboard.
#
# Modes:
#   --snapshot   one-shot, no cursor moves, exit 0 (used by update-motd.d)
#   --live       loop forever (default for the systemd service): home cursor,
#                render frame, erase from cursor to end-of-screen, sleep 5
#   --once       one-shot WITH a screen clear (manual `apl-status` use)
#
# Reads only local files / systemctl. Never the network. Tolerates every
# input being absent (degrades to "-" or "(...)" strings instead of failing).
# Wraps systemctl calls in `timeout 2` so a stalled dbus cannot freeze SSH
# login when this script runs as the update-motd.d snapshot.

set -u
LC_ALL=C

# ---- Path overrides (env vars; defaults are the rootfs locations). ---------
: "${PATHS_FEEDER_ID:=/etc/airplanes/feeder-id}"
: "${PATHS_RELEASE_CHANNEL:=/etc/airplanes/release-channel}"
: "${PATHS_MANIFEST:=/etc/airplanes/build-manifest.json}"
: "${PATHS_FEED_ENV:=/etc/airplanes/feed.env}"
: "${PATHS_CLAIM_SECRET:=/etc/airplanes/feeder-claim-secret}"
: "${PATHS_CLAIM_PENDING:=/etc/airplanes/feeder-claim-secret.pending}"
: "${PATHS_CLAIM_VERSION:=/etc/airplanes/feeder-claim-secret.version}"
: "${PATHS_AIRCRAFT_JSON:=/run/readsb/aircraft.json}"
: "${PATHS_THERMAL:=/sys/class/thermal/thermal_zone0/temp}"
: "${PATHS_LOGO:=/usr/local/share/airplanes/logo.txt}"

readonly UNITS=(
    airplanes-feed.service
    airplanes-mlat.service
    readsb.service
    dump978-fa.service
    airplanes-978.service
)

# ---- Color (gated on TTY-ness of stdout + non-dumb $TERM). -----------------
ESC=$'\e'
_use_color() {
    [[ -t 1 ]] || return 1
    case "${TERM:-}" in
        ""|dumb) return 1 ;;
    esac
    return 0
}
if _use_color; then
    C_RESET="${ESC}[0m"
    C_DIM="${ESC}[2m"
    C_BOLD="${ESC}[1m"
    C_OK="${ESC}[32m"
    C_WARN="${ESC}[33m"
    C_FAIL="${ESC}[31m"
    C_HDR="${ESC}[36m"
else
    C_RESET="" C_DIM="" C_BOLD="" C_OK="" C_WARN="" C_FAIL="" C_HDR=""
fi

# ---- String sanitization. Strips non-printable, clamps length. -------------
# Defends against weird hostnames / channel strings landing in our framebuffer
# and emitting terminal escape sequences when we render as root.
sanitize() {
    local s="${1-}" maxlen="${2:-64}" out
    out="$(printf '%s' "$s" | LC_ALL=C tr -cd ' -~')"
    printf '%s' "${out:0:$maxlen}"
}

# ---- Defensive readers (each returns "" on any failure). -------------------
read_feeder_id() {
    [[ -r "$PATHS_FEEDER_ID" ]] || return 0
    local v
    v="$(head -n1 "$PATHS_FEEDER_ID" 2>/dev/null | tr -d '[:space:]')"
    sanitize "$v" 36
}

read_channel() {
    [[ -r "$PATHS_RELEASE_CHANNEL" ]] || return 0
    local v
    v="$(head -n1 "$PATHS_RELEASE_CHANNEL" 2>/dev/null | tr -d '[:space:]')"
    sanitize "$v" 16
}

# Pull the airplanes_feed component SHA (the user-visible "what version of the
# feed software is running"). manifest schema lives in
# image/stage-airplanes/07-finalize. Returns short (7 char) SHA or "".
read_build_short_sha() {
    [[ -r "$PATHS_MANIFEST" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    local sha
    sha="$(jq -r '.components.airplanes_feed // empty' "$PATHS_MANIFEST" 2>/dev/null)"
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 0
    printf '%s' "${sha:0:7}"
}

# Mirror the canonical parser in webconfig/internal/feedenv/feedenv.go:
# match `^\s*KEY=(?:"value"|unquoted)\s*$`, never `source` the file.
# Whitelist callers; here only LATITUDE / LONGITUDE / USER are needed.
read_feed_env_var() {
    local key="$1" line val
    [[ -r "$PATHS_FEED_ENV" ]] || return 0
    case "$key" in
        LATITUDE|LONGITUDE|USER) ;;
        *) return 0 ;;  # whitelist
    esac
    while IFS= read -r line; do
        if [[ "$line" =~ ^[[:space:]]*${key}=\"([^\"]*)\"[[:space:]]*$ ]]; then
            val="${BASH_REMATCH[1]}"
            printf '%s' "$val"
            return 0
        fi
        if [[ "$line" =~ ^[[:space:]]*${key}=([^[:space:]\#]*)[[:space:]]*$ ]]; then
            val="${BASH_REMATCH[1]}"
            printf '%s' "$val"
            return 0
        fi
    done < "$PATHS_FEED_ENV"
    return 0
}

# Claim state. NEVER reads secret contents; existence-check only.
# States:
#   unclaimed                 — no secret file
#   secret-saved              — secret present, no version recorded yet
#   registered (vN)           — secret + version file (last known register OK)
#   rotation-pending          — .pending file present (operator started rotate)
#   * always-prefer the most-actionable hint
claim_state() {
    local version
    if [[ -f "$PATHS_CLAIM_PENDING" ]]; then
        printf 'rotation-pending'
        return
    fi
    if [[ ! -f "$PATHS_CLAIM_SECRET" ]]; then
        printf 'unclaimed'
        return
    fi
    if [[ -r "$PATHS_CLAIM_VERSION" ]]; then
        version="$(head -n1 "$PATHS_CLAIM_VERSION" 2>/dev/null | tr -d '[:space:]')"
        if [[ "$version" =~ ^[0-9]+$ ]]; then
            printf 'registered (v%s)' "$version"
            return
        fi
    fi
    printf 'secret-saved'
}

# True (rc 0) if the airplanes-mlat wrapper would early-exit with "MLAT
# DISABLED + sleep 3600". Mirrors feed/scripts/airplanes-mlat.sh:37.
mlat_disabled_by_config() {
    local lat lon user
    lat="$(read_feed_env_var LATITUDE)"
    lon="$(read_feed_env_var LONGITUDE)"
    user="$(read_feed_env_var USER)"
    [[ "${lat:-0}" == "0" || "${lon:-0}" == "0" \
        || "$user" == "0" || "$user" == "disable" || "$user" == "changeme" ]]
}

# Service state. Bounded by `timeout 2` so stalled dbus / systemd cannot
# freeze us (critical for the snapshot path that runs at SSH login).
unit_state() {
    local unit="$1" enabled active_rc
    if ! command -v systemctl >/dev/null 2>&1; then
        printf 'unknown'
        return
    fi
    # MLAT: synthesize "disabled by config" before consulting systemd.
    if [[ "$unit" == 'airplanes-mlat.service' ]] && mlat_disabled_by_config; then
        printf 'disabled-by-config'
        return
    fi
    enabled="$(timeout 2 systemctl is-enabled "$unit" 2>/dev/null || true)"
    case "$enabled" in
        masked) printf 'masked'; return ;;
        disabled|static) ;;  # fall through; check is-active
    esac
    if timeout 2 systemctl is-active --quiet "$unit"; then
        printf 'ok'
        return
    fi
    active_rc=$?
    if (( active_rc == 124 )); then
        printf 'timeout'
        return
    fi
    case "$enabled" in
        disabled) printf 'disabled' ;;
        *) printf 'fail' ;;
    esac
}

# Aircraft snapshot. Returns "<count>|<msgs>|<now>" or "||" on any failure.
read_aircraft_snapshot() {
    [[ -r "$PATHS_AIRCRAFT_JSON" ]] || { printf '||'; return; }
    if ! command -v jq >/dev/null 2>&1; then
        # No jq → can't trust grep parsing. Codex-recommended: render unavailable.
        printf '||'
        return
    fi
    local out
    out="$(timeout 2 jq -r '"\(.aircraft|length)|\(.messages//0)|\(.now//0)"' \
        "$PATHS_AIRCRAFT_JSON" 2>/dev/null)"
    if [[ -z "$out" ]]; then
        printf '||'
        return
    fi
    printf '%s' "$out"
}

read_cpu_temp_c() {
    [[ -r "$PATHS_THERMAL" ]] || return 0
    local raw
    raw="$(head -n1 "$PATHS_THERMAL" 2>/dev/null)"
    [[ "$raw" =~ ^[0-9]+$ ]] || return 0
    awk -v r="$raw" 'BEGIN { printf "%.1f", r/1000 }'
}

read_load_1m() {
    local v
    v="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
    sanitize "$v" 8
}

read_uptime_human() {
    local up_s
    up_s="$(awk '{print int($1)}' /proc/uptime 2>/dev/null)"
    [[ "$up_s" =~ ^[0-9]+$ ]] || return 0
    local d=$(( up_s/86400 )) h=$(( (up_s%86400)/3600 )) m=$(( (up_s%3600)/60 ))
    if   (( d > 0 )); then printf '%dd %dh %dm' "$d" "$h" "$m"
    elif (( h > 0 )); then printf '%dh %dm' "$h" "$m"
    else                    printf '%dm' "$m"
    fi
}

# IP primary; .local secondary. Suppress .local when hostname is the Pi OS
# default `raspberrypi` (collides with every other default-hostname Pi on
# the LAN — mDNS resolution is undefined).
read_local_urls() {
    local h ip parts=()
    h="$(hostname -s 2>/dev/null || true)"
    h="$(sanitize "$h" 32)"
    ip="$(ip -4 -o addr show scope global 2>/dev/null \
            | awk '{print $4}' | cut -d/ -f1 | head -n1)"
    ip="$(sanitize "$ip" 39)"  # IPv4 max length

    if [[ -n "$ip" ]]; then
        parts+=("http://${ip}")
    fi
    if [[ -n "$h" && "$h" != "localhost" && "$h" != "raspberrypi" ]]; then
        parts+=("http://${h}.local")
    fi
    if (( ${#parts[@]} == 0 )); then
        printf '%s' '(not connected)'
        return
    fi
    local IFS='@'  # join via odd separator we then rewrite (avoid $* glob)
    local joined="${parts[*]}"
    printf '%s' "${joined//@/  or  }"
}

# ---- Per-frame state for msgs/sec (live mode only). -----------------------
PREV_MSGS=""
PREV_TS=""

# ---- Render a single frame. ------------------------------------------------
# Args: $1 = mode hint ("snapshot" suppresses the rate field).
render_once() {
    local mode="${1:-live}"

    local id channel build claim urls
    id="$(read_feeder_id)"
    channel="$(read_channel)"
    build="$(read_build_short_sha)"
    claim="$(claim_state)"
    urls="$(read_local_urls)"

    # Aircraft + msgs/sec
    local snap cnt msgs now mps='-'
    snap="$(read_aircraft_snapshot)"
    IFS='|' read -r cnt msgs now <<< "$snap"

    if [[ "$mode" != "snapshot" ]] \
        && [[ -n "$msgs" && -n "$now" \
            && -n "$PREV_MSGS" && -n "$PREV_TS" ]]; then
        local d_msgs d_t
        d_msgs=$(( msgs - PREV_MSGS ))
        d_t="$(awk -v a="$now" -v b="$PREV_TS" 'BEGIN{printf "%.3f", a-b}')"
        if awk -v dt="$d_t" 'BEGIN{exit (dt<=0)}'; then
            mps="$(awk -v m="$d_msgs" -v dt="$d_t" \
                'BEGIN{printf "%.1f", m/dt}')"
        fi
    fi
    PREV_MSGS="$msgs"
    PREV_TS="$now"

    # MLAT-warning banner: lat/lon=0 means user has not configured location.
    local lat lon mlat_warn=""
    lat="$(read_feed_env_var LATITUDE)"
    lon="$(read_feed_env_var LONGITUDE)"
    if [[ "${lat:-0}" == "0" || "${lon:-0}" == "0" ]]; then
        mlat_warn="${C_WARN}Set lat/lon to enable MLAT.${C_RESET}"
    fi

    # ---- Output. ---------
    if [[ -r "$PATHS_LOGO" ]]; then
        printf '%s' "$C_HDR"
        cat "$PATHS_LOGO"
        printf '%s\n\n' "$C_RESET"
    fi

    printf '%bAccess%b      %s\n'    "$C_BOLD" "$C_RESET" "$urls"
    printf '%bFeeder ID%b   %s\n'    "$C_BOLD" "$C_RESET" "${id:-(not yet generated)}"
    printf '%bClaim%b       %s\n\n'  "$C_BOLD" "$C_RESET" "$(claim_color "$claim")"

    printf '%bServices%b    ' "$C_BOLD" "$C_RESET"
    local first=1 u s
    for u in "${UNITS[@]}"; do
        s="$(unit_state "$u")"
        (( first )) || printf '  '
        first=0
        printf '%s' "$(svc_marker "$u" "$s")"
    done
    printf '\n\n'

    if [[ "$mode" == "snapshot" ]]; then
        printf '%bFeed%b        aircraft: %s   %s\n' \
            "$C_BOLD" "$C_RESET" "${cnt:--}" "$mlat_warn"
    else
        printf '%bFeed%b        aircraft: %s   msgs/s: %s   %s\n' \
            "$C_BOLD" "$C_RESET" "${cnt:--}" "$mps" "$mlat_warn"
    fi
    printf '%bBuild%b       channel=%s  sha=%s\n' \
        "$C_BOLD" "$C_RESET" "${channel:-?}" "${build:-?}"
    local cpu_temp uptime_h load_1m
    cpu_temp="$(read_cpu_temp_c)"
    uptime_h="$(read_uptime_human)"
    load_1m="$(read_load_1m)"
    if [[ -n "$cpu_temp" ]]; then
        printf '%bSystem%b      uptime %s%s%s   load %s%s%s   CPU %s%s°C%s\n' \
            "$C_BOLD" "$C_RESET" \
            "$C_DIM" "${uptime_h:--}" "$C_RESET" \
            "$C_DIM" "${load_1m:--}" "$C_RESET" \
            "$C_DIM" "$cpu_temp" "$C_RESET"
    else
        printf '%bSystem%b      uptime %s%s%s   load %s%s%s\n' \
            "$C_BOLD" "$C_RESET" \
            "$C_DIM" "${uptime_h:--}" "$C_RESET" \
            "$C_DIM" "${load_1m:--}" "$C_RESET"
    fi

    if [[ "$mode" != "snapshot" ]]; then
        printf '\n%bLocal login moved to TTY2 (Alt+F2). Refreshing every 5s.%b\n' \
            "$C_DIM" "$C_RESET"
    fi
}

claim_color() {
    case "$1" in
        registered*)        printf '%b%s%b' "$C_OK" "$1" "$C_RESET" ;;
        secret-saved)       printf '%b%s%b' "$C_WARN" "$1" "$C_RESET" ;;
        rotation-pending)   printf '%b%s%b' "$C_WARN" "$1" "$C_RESET" ;;
        *)                  printf '%b%s%b — sudo apl-feed claim register' \
                                "$C_WARN" "$1" "$C_RESET" ;;
    esac
}

svc_marker() {
    local unit="$1"
    local s="$2"
    # Strip the redundant "airplanes-" / ".service" so the row fits 80 cols.
    local short="${unit%.service}"
    short="${short#airplanes-}"
    case "$s" in
        ok)
            printf '%b%s:OK%b' "$C_OK" "$short" "$C_RESET"
            ;;
        fail)
            printf '%b%s:FAIL%b' "$C_FAIL" "$short" "$C_RESET"
            ;;
        masked)
            printf '%b%s:MASK%b' "$C_FAIL" "$short" "$C_RESET"
            ;;
        disabled|disabled-by-config)
            printf '%b%s:off%b' "$C_DIM" "$short" "$C_RESET"
            ;;
        timeout)
            printf '%b%s:?%b' "$C_DIM" "$short" "$C_RESET"
            ;;
        *)
            printf '%b%s:?%b' "$C_DIM" "$short" "$C_RESET"
            ;;
    esac
}

# ---- Mode dispatcher. ------------------------------------------------------
# Skip when sourced (bats tests source us to call helpers directly).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    mode="${1:---live}"
    case "$mode" in
        --snapshot)
            render_once snapshot
            ;;
        --once)
            printf '%s[2J%s[H' "$ESC" "$ESC"
            render_once live
            ;;
        --live|*)
            # Cursor home + render frame + erase-to-end-of-screen — less
            # flicker than \e[2J\e[H (full clear then home).
            while :; do
                printf '%s[H' "$ESC"
                render_once live
                printf '%s[J' "$ESC"
                sleep 5
            done
            ;;
    esac
fi
