[Unit]
Description=airplanes.live console dashboard on /dev/tty1
Documentation=https://github.com/airplanes-live/image
ConditionPathExists=/dev/tty1
Conflicts=getty@tty1.service
After=systemd-vconsole-setup.service systemd-user-sessions.service
After=getty@tty1.service airplanes-first-run.service
# Crashloop guard (StartLimit* belong in [Unit], not [Service]).
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/lib/airplanes/render-status --live
Restart=on-failure
RestartSec=10s

# Own /dev/tty1 like a getty does. We never read input — render-status only
# writes — but TTYPath ensures we get the VT cleanly on every restart.
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# Hardening — only what's safe for a script that needs /dev/tty1 (rules out
# PrivateDevices=yes) and netlink (rules out RestrictAddressFamilies=AF_UNIX).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=getty.target
