[Unit]
Description=airplanes-978 UAT consumer
After=airplanes-first-run.service dump978-fa.service network.target
Wants=network.target dump978-fa.service

[Service]
Type=simple
EnvironmentFile=-/etc/airplanes/feed.env
User=readsb
RuntimeDirectory=airplanes-978
RuntimeDirectoryMode=0755
ExecStart=/usr/local/share/airplanes/airplanes-978.sh
Restart=always
RestartSec=15
Nice=-5

[Install]
WantedBy=multi-user.target
